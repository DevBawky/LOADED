    m_Localized: Monopoly Round
    m_Metadata:
      m_Items: []
  - m_Id: 966328544
    m_Localized: Final damage +40% per bullet of your most common grade
    m_Metadata:
      m_Items: []
  - m_Id: 966328545
    m_Localized: Final damage +50% per bullet of your most common grade
    m_Metadata:
      m_Items: []
  - m_Id: 966328546
    m_Localized: Final damage +75% per bullet of your most common grade
    m_Metadata:
      m_Items: []
  - m_Id: 966328547
    m_Localized: Destroy this bullet on firing (5%)
    m_Metadata:
      m_Items: []
  - m_Id: 966328548
    m_Localized: Enhanced Round
    m_Metadata:
      m_Items: []
  - m_Id: 966328549
    m_Localized: 'Destroy this bullet on firing (5%)

      Pierce 1 times (20%)'
    m_Metadata:
      m_Items: []
  - m_Id: 966328550
    m_Localized: 'Destroy this bullet on firing (3%)

      Pierce 1 times (40%)'
    m_Metadata:
      m_Items: []
  - m_Id: 966328551
    m_Localized: 'Destroy this bullet on firing (1%)

      Keep piercing (40%)'
    m_Metadata:
      m_Items: []
  - m_Id: 966328552
    m_Localized: ENEMY PHASE
    m_Metadata:
      m_Items: []
  - m_Id: 966328553
    m_Localized: 'Living enemies: <size=30> {0}'
    m_Metadata:
