    m_Localized: PLAYER PHASE
    m_Metadata:
      m_Items: []
  - m_Id: 966328555
    m_Localized: 'Enemies remaining: <size=30>{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 966328556
    m_Localized: ENEMY PHASE
    m_Metadata:
      m_Items: []
  - m_Id: 966328557
    m_Localized: 'Living enemies: <size=30> {0}'
