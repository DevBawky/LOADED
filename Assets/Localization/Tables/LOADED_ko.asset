  - m_Id: 966328864
    m_Localized: "\uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uAE30\uC808 3\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328865
    m_Localized: "\uC804\uAE30\uCDA9\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 966328866
    m_Localized: "\uD134\uC744 \uC18C\uBAA8\uD558\uC9C0 \uC54A\uACE0 \uD604\uC7AC
      \uB4DC\uB85C\uC6B0 \uB371\uC744 \uC989\uC2DC \uB2E4\uC2DC \uC11E\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328867
    m_Localized: "\uB371 \uC7AC\uC154\uD50C\uB7EC"
    m_Metadata:
      m_Items: []
  - m_Id: 966328868
    m_Localized: "\uCCB4\uB825\uC744 \uC989\uC2DC 20 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328869
    m_Localized: "\uD68C\uBCF5 \uD3EC\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 966328870
    m_Localized: "\uC804\uBC29\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uACFC
