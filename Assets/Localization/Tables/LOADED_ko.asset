      m_Items: []
  - m_Id: 974716956
    m_Localized: "\uB178\uC778\uC740 \uD0C4\uD658\uC758 \uB0B4\uC6A9\uBB3C\uC744
      \uAC00\uB9AC\uACE0 {0} \uB4F1\uAE09 \uD14C\uB450\uB9AC\uB9CC \uB0B4\uBC00\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716957
    m_Localized: "{0}\n\uC124\uBA85: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 974716958
    m_Localized: "\uB178\uC778\uC774 \uBB34\uB98E\uC744 \uCE58\uBA70 30 \uACE8\uB4DC\uB97C
      \uC3DF\uC544 \uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716959
    m_Localized: "\uB178\uC778\uC740 \uD2C0\uB838\uB2E4\uBA70 \uB084\uB084\uB314\uB2E4.
      \uBCF4\uC0C1\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716960
    m_Localized: "\uC138 \uB9B4\uC774 \uB9DE\uBB3C\uB838\uB2E4. \uADF8\uB9BC\uC758
      \uC804\uB9AC\uD488\uACFC \uC7AD\uD31F\uD0C4(+3)\uC774 \uD280\uC5B4\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716961
    m_Localized: "\uB450 \uB9B4\uC774 \uB9DE\uC558\uB2E4. {0} \uACE8\uB4DC\uB97C
      \uBC1B\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716962
    m_Localized: "\uB9B4\uC740 \uC11C\uB85C \uB2E4\uB978 \uADF8\uB9BC\uC5D0\uC11C
      \uBA4E\uC5C8\uB2E4. \uB3C4\uBC15\uC0AC\uB294 \uB3C8\uC744 \uC4F8\uC5B4 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716963
    m_Localized: "\uC544\uC774\uD15C \uC120\uD0DD \uC644\uB8CC ({0}/{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 974716964
    m_Localized: "\uC720\uBB3C \uC120\uD0DD \uC644\uB8CC ({0}/{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 974716965
    m_Localized: "\uD45C\uC2DC\uD560 \uC774\uBCA4\uD2B8\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.
      EventDefinition\uC744 \uC774\uBCA4\uD2B8 \uD480\uC5D0 \uCD94\uAC00\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974716966
    m_Localized: "\uB178\uB4DC\uB9F5\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974716967
    m_Localized: "{0}\uC6B0\uD074\uB9AD\uC744 \uD1B5\uD574 \uD310\uB9E4: ${1}"
    m_Metadata:
      m_Items: []
  - m_Id: 974716968
    m_Localized: "\uB3C5"
    m_Metadata:
      m_Items: []
  - m_Id: 974716969
    m_Localized: "\uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 974716970
    m_Localized: "\uC57D\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 974716971
    m_Localized: "\uD45C\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 974716972
    m_Localized: "\uB3C5"
    m_Metadata:
      m_Items: []
  - m_Id: 974716973
    m_Localized: "\uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 974716974
    m_Localized: "\uC57D\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 974716975
    m_Localized: "\uD45C\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 974716976
    m_Localized: "\uC2E4\uB9B0\uB354 \uD15C\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 974716977
    m_Localized: "\uC2DC\uAC04\uC740 \uC800\uC808\uB85C \uD750\uB974\uC9C0 \uC54A\uACE0
      <color=#FFD05A><b>\uD50C\uB808\uC774\uC5B4 \uD589\uB3D9</b></color>\uC73C\uB85C\uB9CC
      \uC2E4\uB9B0\uB354 \uD15C\uD3EC\uAC00 \uCDA9\uC804\uB429\uB2C8\uB2E4.\n\uC774\uB3D9\uC740
      2\uCE78, \uD68C\uC804\uACFC \uB300\uAE30\uB294 1\uCE78, \uC7A5\uC804\uACFC
      \uBC1C\uC0AC\uB294 3\uCE78\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\uD15C\uD3EC\uAC00
      <color=#FF5757><b>6\uCE78</b></color>\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uBAA8\uB4E0
      \uC801\uC774 \uD55C \uBC88\uC529 \uD589\uB3D9\uD558\uBA70, \uACF5\uACA9 \uC21C\uAC04\uC5D0
      \uC774\uB3D9\uD558\uBA74 \uD68C\uD53C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716978
    m_Localized: "\uC801\uC758 \uACF5\uACA9 \uC608\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 974716979
    m_Localized: "\uACF5\uACA9 \uC900\uBE44 \uC2DC <color=#FF5757><b>\uACBD\uACE0\uC74C</b></color>\uC774
      \uC6B8\uB9BD\uB2C8\uB2E4.\n<color=#FF5757><b>\uC801 \uC544\uB798\uC758 \uD589\uB3D9
      \uD328\uB110</b></color>\uB3C4 \uBD89\uC5B4\uC9D1\uB2C8\uB2E4.\n\uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC740 \uACBD\uB85C\uC640 \uBC94\uC704\uB3C4 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uB2E4\uC74C
      \uC801 \uD589\uB3D9 \uC8FC\uAE30 \uC804\uC5D0 \uD53C\uD558\uAC70\uB098 \uB300\uBE44\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974716980
    m_Localized: "\uD68C\uD53C\uC640 \uBB34\uBC29\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 974716981
    m_Localized: "\uC801\uC758 \uACF5\uACA9\uC774 \uB9DE\uAE30 \uC9C1\uC804\uC5D0
      <color=#62D9FF><b>\uD53C\uACA9 \uBC94\uC704 \uBC16\uC73C\uB85C \uC774\uB3D9</b></color>\uD558\uBA74
      \uD68C\uD53C\uD569\uB2C8\uB2E4.\n\uD68C\uD53C\uC5D0 \uC2E4\uD328\uD55C \uC801\uC740
      <color=#FF9F5A><b>\uBB34\uBC29\uBE44</b></color>\uAC00 \uB418\uC5B4 \uB2E4\uC74C
      \uD53C\uACA9\uC774 \uD06C\uB9AC\uD2F0\uCEEC\uB85C \uD655\uC815\uB429\uB2C8\uB2E4.\n\uBB34\uBC29\uBE44\uB294
      <color=#FFD05A><b>\uD55C \uBC88 \uD53C\uACA9</b></color>\uB418\uAC70\uB098,
      \uACF5\uACA9\uD558\uC9C0 \uC54A\uACE0 <color=#FF5757><b>\uB2E4\uB978 \uD589\uB3D9</b></color>\uC744
      \uD558\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716982
    m_Localized: "\uD575\uC2EC \uC804\uB7B5: \uD0C4\uD658 \uC21C\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 974716983
    m_Localized: "<color=#FFD05A><b>\uD0C4\uD658 \uC21C\uC11C\uC5D0 \uB530\uB77C
      \uD53C\uD574\uB7C9\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.</b></color>\n\uC2E4\uB9B0\uB354\uB294
      <color=#FFD05A><b>\uB098\uC911\uC5D0 \uC7A5\uC804\uD55C \uD0C4\uD658\uBD80\uD130</b></color>
      \uBC1C\uC0AC\uD558\uBA70, \uD0C4\uD658 \uD6A8\uACFC\uB3C4 \uC55E\uB4A4 \uC21C\uC11C\uC640
      \uC5F0\uACC4\uB429\uB2C8\uB2E4.\n\uBC1C\uC0AC \uC804\uC5D0 <color=#FF5757><b>\uB9C8\uC6B0\uC2A4
      \uB4DC\uB798\uADF8</b></color>\uB85C \uC21C\uC11C\uB97C \uBC14\uAFB8\uACE0
      <color=#FFD05A><b>\uC608\uC0C1 \uD53C\uD574</b></color>\uB97C \uBE44\uAD50\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974716984
    m_Localized: "\uC0AC\uAC70\uB9AC\uC640 \uACF5\uACA9 \uBC29\uD5A5"
    m_Metadata:
      m_Items: []
  - m_Id: 974716985
    m_Localized: "\uD0C4\uD658\uC740 <color=#FFD05A><b>\uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5</b></color>\uC73C\uB85C
      \uBC1C\uC0AC\uB429\uB2C8\uB2E4.\n\uD0C4\uD658\uB9C8\uB2E4 <color=#FFD05A><b>\uC0AC\uAC70\uB9AC</b></color>\uAC00
      \uB2E4\uB985\uB2C8\uB2E4.\n\uD0C4\uD658 \uC815\uBCF4\uC5D0\uC11C <color=#FFD05A><b>\uC720\uD6A8
      \uBC94\uC704 N\uCE78</b></color>\uC744 \uD655\uC778\uD558\uC138\uC694.\n\uC608\uC0C1
      \uD53C\uD574\uAC00 \uC5C6\uB2E4\uBA74 <color=#FFD05A><b>\uBC29\uD5A5, \uAC70\uB9AC,
      \uC55E\uC744 \uB9C9\uB294 \uC801</b></color>\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974716986
    m_Localized: "\uCF64\uBCF4\uC640 4\uCE78 \uAC8C\uC774\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 974716987
    m_Localized: "\uC801\uC744 \uCC98\uCE58\uD558\uBA74 <color=#FFD05A><b>\uCF64\uBCF4
      \uAC8C\uC774\uC9C0 4\uCE78</b></color>\uC774 \uCDA9\uC804\uB429\uB2C8\uB2E4.\n\uC2E4\uB9B0\uB354
      \uD15C\uD3EC 6\uCE78\uC774 \uCC28\uC11C <color=#FF5757><b>\uC801 \uD589\uB3D9
      \uC8FC\uAE30\uAC00 \uD655\uC815</b></color>\uB420 \uB54C\uB9C8\uB2E4 \uD55C
      \uCE78\uC529 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\uAC8C\uC774\uC9C0\uAC00 \uC0AC\uB77C\uC9C0\uAE30
      \uC804\uC5D0 \uCD94\uAC00 \uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uB2E4\uC2DC
      4\uCE78\uC774 \uB418\uACE0 \uCF64\uBCF4\uAC00 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716988
    m_Localized: "\uB514\uBC84\uD504 \uC885\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 974716989
    m_Localized: "<color=#FF7D7D><b>\uD45C\uC2DD: \uBC1B\uB294 \uD53C\uD574 50% \uC99D\uAC00</b></color>\n<color=#78D987><b>\uB3C5:
      \uC801 \uD589\uB3D9 \uC8FC\uAE30 \uC885\uB8CC \uC2DC \uC2A4\uD0DD\uB9CC\uD07C
      \uD53C\uD574, \uC774\uD6C4 1 \uAC10\uC18C</b></color>\n<color=#75C7FF><b>\uAE30\uC808:
      \uC801 \uD589\uB3D9 \uC8FC\uAE30\uB9C8\uB2E4 \uD589\uB3D9 \uBD88\uAC00, \uC774\uD6C4
      1 \uAC10\uC18C</b></color>\n<color=#C69CFF><b>\uC57D\uD654: \uACF5\uACA9\uB825
      30% \uAC10\uC18C</b></color>\n<color=#FF9F5A><b>\uBB34\uBC29\uBE44: \uD68C\uD53C
      \uC131\uACF5 \uC2DC \uACF5\uACA9\uD55C \uC801\uC5D0\uAC8C \uC801\uC6A9\uB418\uB294
      \uBE44\uC2A4\uD0DD \uB514\uBC84\uD504. \uB2E4\uC74C \uD53C\uACA9\uC774 \uD06C\uB9AC\uD2F0\uCEEC\uB85C
      \uD655\uC815\uB418\uBA70, \uCCAB \uD53C\uACA9 \uB610\uB294 \uB2E4\uB978 \uD589\uB3D9
      \uC2DC \uD574\uC81C</b></color>\n\uC801\uC5D0\uAC8C \uB514\uBC84\uD504\uAC00
      \uC788\uB2E4\uBA74 \uC544\uB798\uC640 \uAC19\uC740 \uC0C1\uD0DC \uC544\uC774\uCF58\uC774
      \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uC544\uC774\uCF58\uC5D0 <color=#FF5757><b>\uB9C8\uC6B0\uC2A4
      \uCEE4\uC11C\uB97C \uC62C\uB9AC\uBA74</b></color> \uD6A8\uACFC\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716990
    m_Localized: "\uB178\uB4DC\uB9F5\uACFC \uACBD\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 974716991
    m_Localized: "\uB178\uB4DC\uB9F5\uC740 \uC774\uBC88 \uB7F0\uC5D0\uC11C \uC774\uB3D9\uD560
      \uACBD\uB85C\uB97C \uC120\uD0DD\uD558\uB294 \uD654\uBA74\uC785\uB2C8\uB2E4.\n\uD604\uC7AC
      \uC704\uCE58\uC5D0\uC11C \uC774\uC5B4\uC9C4 <color=#8FE6FF><b>\uBC1D\uC740
      \uACBD\uB85C</b></color>\uB97C \uB530\uB77C \uB2E4\uC74C \uB178\uB4DC\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD55C \uBC88 \uC120\uD0DD\uD55C
      \uACBD\uB85C\uB294 \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uC73C\uB2C8 \uC55E\uC73C\uB85C
      \uB9CC\uB0A0 \uB178\uB4DC\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974716992
    m_Localized: "\uB178\uB4DC\uC758 \uC885\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 974716993
    m_Localized: "<color=#B8C6D9><b>\uC2DC\uC791</b></color>: \uD604\uC7AC \uB7F0\uC758
      \uCD9C\uBC1C\uC810\n<color=#FFD05A><b>\uC804\uD22C</b></color>: \uC77C\uBC18
      \uC801\uACFC \uC804\uD22C\n<color=#FF8D6B><b>\uC815\uC608 \uC804\uD22C</b></color>:
      \uB354 \uAC15\uD55C \uC801\uACFC \uC804\uD22C\n<color=#76E38A><b>\uC0C1\uC810</b></color>:
      \uAD6C\uB9E4, \uD310\uB9E4\uC640 \uD0C4\uD658 \uAD00\uB9AC\n<color=#C69CFF><b>\uC774\uBCA4\uD2B8</b></color>:
      \uC120\uD0DD\uC5D0 \uB530\uB77C \uACB0\uACFC\uAC00 \uB2EC\uB77C\uC9C0\uB294
      \uC0AC\uAC74\n<color=#8FE6FF><b>\uBCF4\uBB3C</b></color>: \uC720\uBB3C\uACFC
      \uBCF4\uC0C1 \uD68D\uB4DD\n<color=#FF5757><b>\uBCF4\uC2A4</b></color>: \uC2A4\uD14C\uC774\uC9C0\uC758
      \uB9C8\uC9C0\uB9C9 \uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 974716994
    m_Localized: "\uB2E4\uC74C \uB178\uB4DC \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 974716995
    m_Localized: "\uC9C0\uAE08 \uC774\uB3D9\uD560 \uC218 \uC788\uB294 \uB178\uB4DC\uB294
      <color=#FFD05A><b>\uBC1D\uAC8C \uD45C\uC2DC</b></color>\uB429\uB2C8\uB2E4.\n\uB178\uB4DC\uC5D0
      \uB9C8\uC6B0\uC2A4 \uCEE4\uC11C\uB97C \uC62C\uB9AC\uBA74 \uC885\uB958\uC640
      \uC124\uBA85\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uB3D9\uD560
      \uB178\uB4DC\uB97C <color=#FF5757><b>\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uD074\uB9AD</b></color>\uD558\uBA74
      \uD574\uB2F9 \uC7A5\uC18C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716996
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 974716997
    m_Localized: "<color=#FF5757><b>WASD \uD0A4</b></color>\uB85C \uC0C1\uD558\uC88C\uC6B0
      \uD55C \uCE78\uC529 \uC774\uB3D9\uD569\uB2C8\uB2E4. A/D\uB294 \uC804\uC7A5\uC744
      \uB530\uB77C \uC774\uB3D9\uD558\uACE0 W/S\uB294 \uB808\uC778\uC744 \uBC14\uAFC9\uB2C8\uB2E4.\n\uC774\uB3D9\uC740
      <color=#FFD05A><b>\uC2E4\uB9B0\uB354 \uD15C\uD3EC 2\uCE78</b></color>\uC744
      \uC0AC\uC6A9\uD558\uBA70, 6\uCE78\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uC801\uC774
      \uD589\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974716998
    m_Localized: "\uD55C \uCE78 \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 974716999
    m_Localized: "\uD68C\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717000
    m_Localized: "<color=#FF5757><b>Q \uD0A4</b></color>, <color=#FF5757><b>\uB9C8\uC6B0\uC2A4
      \uD720 \uD074\uB9AD</b></color> \uB610\uB294 <color=#FF5757><b>\uD68C\uC804
      \uBC84\uD2BC \uD074\uB9AD</b></color>\uC73C\uB85C \uBC29\uD5A5\uC744 \uBC14\uAFC9\uB2C8\uB2E4.\n\uD0C4\uD658\uC740
      <color=#FFD05A><b>\uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5</b></color>\uC73C\uB85C
      \uBC1C\uC0AC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717001
    m_Localized: "\uD55C \uBC88 \uD68C\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717002
    m_Localized: "\uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717003
    m_Localized: "<color=#FF5757><b>E \uD0A4</b></color> \uB610\uB294 <color=#FF5757><b>\uB300\uAE30
      \uBC84\uD2BC \uD074\uB9AD</b></color>\uC73C\uB85C \uC81C\uC790\uB9AC\uC5D0\uC11C
      \uC2E4\uB9B0\uB354 \uD15C\uD3EC 1\uCE78\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717004
    m_Localized: "\uD55C \uBC88 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717005
    m_Localized: "\uC801 \uD589\uB3D9 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 974717006
    m_Localized: "<color=#FFD05A><b>\uC801 \uC544\uB798\uC758 \uD589\uB3D9 \uC544\uC774\uCF58</b></color>\uC5D0\uC11C
      \uB2E4\uC74C \uD589\uB3D9\uC744 \uD655\uC778\uD558\uC138\uC694.\n\uC544\uC774\uCF58\uC774
      \uC5C6\uB2E4\uBA74 \uC2E4\uB9B0\uB354 \uD15C\uD3EC\uB97C \uC9C4\uD589\uD55C
      \uB4A4 <color=#FF5757><b>\uB9C8\uC6B0\uC2A4 \uCEE4\uC11C\uB97C \uC62C\uB9AC\uAC70\uB098
      \uD074\uB9AD</b></color>\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717007
    m_Localized: "\uC801 \uD589\uB3D9 \uC544\uC774\uCF58 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 974717008
    m_Localized: "\uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717009
    m_Localized: "<color=#FF5757><b>R \uD0A4</b></color> \uB610\uB294 <color=#FF5757><b>\uC7A5\uC804
      \uBC84\uD2BC \uD074\uB9AD</b></color>\uC73C\uB85C \uB2E4\uC74C \uD0C4\uD658\uC744
      \uC7A5\uC804\uD569\uB2C8\uB2E4.\n\uC7A5\uC804\uC740 <color=#FFD05A><b>\uC2E4\uB9B0\uB354
      \uD15C\uD3EC 3\uCE78</b></color>\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\uB0A8\uC740
      \uD15C\uD3EC\uC640 \uC801 \uD589\uB3D9\uC744 \uBA3C\uC800 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717010
    m_Localized: "\uD0C4\uD658 3\uD68C \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717011
    m_Localized: "\uC57D\uC2E4 \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 974717012
    m_Localized: "\uC2E4\uB9B0\uB354\uC5D0\uC11C \uC81C\uAC70\uD560 \uD0C4\uD658\uC744
      <color=#FF5757><b>\uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD</b></color>\uD558\uC138\uC694.\n\uC81C\uAC70\uD55C
      \uD0C4\uD658\uC740 \uD30C\uAD34\uB418\uC9C0 \uC54A\uACE0 <color=#FFD05A><b>\uC0AC\uC6A9\uD55C
      \uD0C4\uD658 \uC21C\uD658</b></color>\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\uC57D\uC2E4
      \uC81C\uAC70\uB294 <color=#FFD05A><b>\uC2E4\uB9B0\uB354 \uD15C\uD3EC\uB97C
      \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</b></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 974717013
    m_Localized: "\uC2E4\uB9B0\uB354 \uD0C4\uD658 \uD55C \uBC1C \uC6B0\uD074\uB9AD\uD574
      \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 974717014
    m_Localized: "\uD0C4\uD658 \uC815\uBCF4 \uC77D\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717015
    m_Localized: "\uC2E4\uB9B0\uB354 \uD0C4\uD658\uC774\uB098 \uB2E4\uC74C \uD0C4\uD658\uC5D0
      <color=#FF5757><b>\uB9C8\uC6B0\uC2A4 \uCEE4\uC11C\uB97C \uC62C\uB9AC\uC138\uC694.</b></color>\n<color=#FFD05A><b>\uD53C\uD574,
      \uC720\uD6A8 \uBC94\uC704, \uCE58\uBA85\uD0C0 \uD655\uB960, \uD2B9\uC218 \uD6A8\uACFC</b></color>\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717016
    m_Localized: "\uD0C4\uD658 \uC815\uBCF4\uC5D0\uC11C \uD53C\uD574\uC640 \uC0AC\uAC70\uB9AC
      \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 974717017
    m_Localized: "\uC2E4\uB9B0\uB354 \uC21C\uC11C \uC870\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 974717018
    m_Localized: "<color=#FFD05A><b>\uD0C4\uD658 \uC21C\uC11C\uC5D0 \uB530\uB77C
      \uD53C\uD574\uB7C9\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.</b></color>\n\uC2E4\uB9B0\uB354
      \uD0C4\uD658\uC744 \uB2E4\uB978 \uD0C4\uD658 \uC704\uB85C <color=#FF5757><b>\uB9C8\uC6B0\uC2A4
      \uB4DC\uB798\uADF8</b></color>\uD558\uC138\uC694.\n<color=#FFD05A><b>\uB098\uC911\uC5D0
      \uC7A5\uC804\uD55C \uD0C4\uD658\uBD80\uD130</b></color> \uBC1C\uC0AC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717019
    m_Localized: "\uD0C4\uD658 \uC21C\uC11C \uD55C \uBC88 \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 974717020
    m_Localized: "\uC801 \uD53C\uD574 \uC608\uC0C1\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 974717021
    m_Localized: "\uC2E4\uB9B0\uB354 \uD0C4\uD658\uC5D0 <color=#FF5757><b>\uB9C8\uC6B0\uC2A4
      \uCEE4\uC11C\uB97C \uC62C\uB9AC\uC138\uC694.</b></color>\n\uD574\uB2F9 \uD0C4\uD658\uAE4C\uC9C0
      \uBC1C\uC0AC\uD560 <color=#FFD05A><b>\uC608\uC0C1 \uD53C\uD574</b></color>\uAC00
      \uC801 \uCCB4\uB825\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717022
    m_Localized: "\uC2E4\uB9B0\uB354 \uD0C4\uD658\uC758 \uC608\uC0C1 \uD53C\uD574
      \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 974717023
    m_Localized: "\uC544\uC774\uD15C \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717024
    m_Localized: "\uBAA8\uB4E0 \uC801\uC744 \uAE30\uC808\uC2DC\uD0A4\uB294 <color=#FFD05A><b>\uC804\uAE30\uCDA9\uACA9</b></color>\uC744
      \uC9C0\uAE09\uD569\uB2C8\uB2E4.\n<color=#FF5757><b>1/2/3 \uD0A4</b></color>
      \uB610\uB294 <color=#FF5757><b>\uC778\uBCA4\uD1A0\uB9AC \uC2AC\uB86F \uD074\uB9AD</b></color>\uC73C\uB85C
      \uC0AC\uC6A9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717025
    m_Localized: "\uC804\uAE30\uCDA9\uACA9 \uD55C \uBC88 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717026
    m_Localized: "\uBC1C\uCC28\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717027
    m_Localized: "\uBC14\uB85C \uC55E\uC758 \uC801 \uBC29\uD5A5\uC73C\uB85C \uC774\uB3D9\uD558\uBA74
      \uBC1C\uCC28\uAE30\uD569\uB2C8\uB2E4.\n<color=#FF5757><b>A/D \uD0A4</b></color>
      \uB610\uB294 <color=#FF5757><b>\uC774\uB3D9 \uBC84\uD2BC \uD074\uB9AD</b></color>\uC744
      \uC0AC\uC6A9\uD558\uC138\uC694.\n\uBC1C\uCC28\uAE30 \uD6C4 <color=#FFD05A><b>\uC720\uB8CC
      \uD589\uB3D9 3\uD68C</b></color> \uB3D9\uC548 \uB2E4\uC2DC \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC801\uB07C\uB9AC \uBD80\uB52A\uD788\uBA74
      <color=#FFD05A><b>\uB458 \uB2E4 \uD53C\uD574</b></color>\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717028
    m_Localized: "\uC801\uC744 \uD55C \uBC88 \uBC1C\uCC28\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717029
    m_Localized: "\uBC1C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717030
    m_Localized: "<color=#FF5757><b>\uD654\uBA74\uC5D0 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD
      \uD074\uB9AD</b></color>, <color=#FF5757><b>\uC2A4\uD398\uC774\uC2A4 \uBC14</b></color>
      \uB610\uB294 <color=#FF5757><b>\uC0AC\uACA9 \uBC84\uD2BC \uD074\uB9AD</b></color>\uC73C\uB85C
      \uD0C4\uD658\uC744 <color=#FFD05A><b>\uC21C\uC11C\uB300\uB85C \uBAA8\uB450
      \uBC1C\uC0AC</b></color>\uD569\uB2C8\uB2E4.\n\uBC1C\uC0AC \uC804\uC5D0 <color=#FFD05A><b>\uBC29\uD5A5,
      \uC0AC\uAC70\uB9AC, \uD0C4\uD658 \uC21C\uC11C</b></color>\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717031
    m_Localized: "\uC2E4\uB9B0\uB354 \uBC1C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717032
    m_Localized: "\uC0C1\uD488 \uAD6C\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 974717033
    m_Localized: "\uC0C1\uB2E8\uC5D0\uC11C <color=#FFD05A><b>\uD0C4\uD658\uACFC \uC544\uC774\uD15C</b></color>\uC744
      \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC0C1\uD488\uC5D0 \uB9C8\uC6B0\uC2A4
      \uCEE4\uC11C\uB97C \uC62C\uB824 <color=#FFD05A><b>\uD6A8\uACFC\uC640 \uAC00\uACA9</b></color>\uC744
      \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717034
    m_Localized: "\uD0C4\uD658 \uAD00\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717035
    m_Localized: "\uD0C4\uD658 \uAD00\uB9AC\uC5D0\uC11C \uBCF4\uC720 \uD0C4\uD658\uC744
      <color=#FFD05A><b>\uAC15\uD654\uD558\uAC70\uB098 \uC81C\uAC70</b></color>\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBE44\uC6A9\uC740 \uC120\uD0DD\uD55C \uD0C4\uD658
      \uC544\uB798\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717036
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717037
    m_Localized: "\uC67C\uCABD \uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C <color=#FFD05A><b>\uBCF4\uC720
      \uC544\uC774\uD15C</b></color>\uC744 \uD655\uC778\uD558\uC138\uC694.\n\uC804\uD22C\xB7\uC0C1\uC810\xB7\uC774\uBCA4\uD2B8\xB7\uBCF4\uBB3C\uC5D0\uC11C\uB294
      \uC544\uC774\uD15C\uC744 <color=#FF5757><b>\uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD</b></color>\uD574
      \uD310\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717038
    m_Localized: "\uC0C8\uB85C\uACE0\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 974717039
    m_Localized: "\uC6D0\uD558\uB294 \uC0C1\uD488\uC774 \uC5C6\uB2E4\uBA74 <color=#FFD05A><b>\uC0C8\uB85C\uACE0\uCE68</b></color>\uD558\uC138\uC694.\n\uC0C8\uB85C\uACE0\uCE68\uD560
      \uB54C\uB9C8\uB2E4 \uB2E4\uC74C \uBE44\uC6A9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717040
    m_Localized: "\uB2E4\uC74C \uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717041
    m_Localized: "<color=#FFD05A><b>\uAD6C\uB9E4\uC640 \uD0C4\uD658 \uAD00\uB9AC</b></color>\uB97C
      \uB9C8\uCE5C \uB4A4 \uC774 \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694.\n<color=#FFD05A><b>\uB2E4\uC74C
      \uC804\uD22C</b></color>\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717042
    m_Localized: "\uC774\uBCA4\uD2B8 \uC77D\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717043
    m_Localized: "\uC774\uBCA4\uD2B8\uC758 <color=#FFD05A><b>\uC81C\uBAA9\uACFC \uC0C1\uD669
      \uC124\uBA85</b></color>\uC744 \uC77D\uC5B4 \uBCF4\uC138\uC694.\n\uAC19\uC740
      \uC774\uBCA4\uD2B8\uB77C\uB3C4 \uC120\uD0DD\uC5D0 \uB530\uB77C \uACB0\uACFC\uAC00
      \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717044
    m_Localized: "\uC120\uD0DD\uACFC \uACB0\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717045
    m_Localized: "\uC120\uD0DD\uC9C0\uC5D0\uB294 <color=#FFD05A><b>\uBE44\uC6A9,
      \uC870\uAC74, \uD655\uB960</b></color>\uC774 \uD3EC\uD568\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB0B4\uC6A9\uC744
      \uD655\uC778\uD558\uACE0 \uC6D0\uD558\uB294 \uC120\uD0DD\uC9C0\uB97C \uD074\uB9AD\uD55C
      \uB4A4 \uACB0\uACFC\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717046
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717047
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790\uB97C \uD074\uB9AD\uD558\uBA74 \uC774\uBC88\uC5D0
      \uD68D\uB4DD\uD560 \uC218 \uC788\uB294 <color=#FFD05A><b>\uC720\uBB3C \uD6C4\uBCF4</b></color>\uAC00
      \uB098\uD0C0\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717048
    m_Localized: "\uC720\uBB3C \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 974717049
    m_Localized: "\uC720\uBB3C\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824 \uD6A8\uACFC\uB97C
      \uD655\uC778\uD558\uACE0 <color=#FF5757><b>\uD558\uB098\uB97C \uC120\uD0DD</b></color>\uD558\uC138\uC694.\n\uC120\uD0DD\uD55C
      \uC720\uBB3C\uC740 \uD604\uC7AC \uB7F0 \uB3D9\uC548 \uD2B9\uBCC4\uD55C \uD6A8\uACFC\uB97C
      \uC81C\uACF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717050
    m_Localized: "\uC544\uC774\uD15C \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717051
    m_Localized: "<color=#FF5757><b>1/2/3 \uD0A4</b></color> \uB610\uB294 <color=#FF5757><b>\uC778\uBCA4\uD1A0\uB9AC
      \uC2AC\uB86F \uD074\uB9AD</b></color>\uC73C\uB85C \uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n<color=#FFD05A><b>\uC0AC\uC6A9 \uC870\uAC74\uC774
      \uB9DE\uC9C0 \uC54A\uC73C\uBA74 \uC18C\uBE44\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</b></color>\n\uC801\uC774
      \uB098\uC628 \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717052
    m_Localized: "\uBCF4\uC720 \uC544\uC774\uD15C \uD55C \uBC88 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
