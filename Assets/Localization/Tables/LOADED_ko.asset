    m_Localized: "\uCD1D\uACF5\uC740 \uC5B4\uAE68\uB97C \uC73C\uC4F1\uD558\uACE0
      \uB2E4\uC2DC \uC791\uC5C5\uB300\uB85C \uB3CC\uC544\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328823
    m_Localized: "\uB354 \uC774\uC0C1 \uC774 \uC120\uD0DD\uC9C0\uB97C \uACE0\uB97C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328824
    m_Localized: "\uCD1D\uACF5\uC740 \uB2F9\uC2E0\uC758 \uCD1D\uC9D1\uC5D0 \uB0A8\uC740
      \uAC15\uC801\uC758 \uD754\uC801\uC744 \uC54C\uC544\uBCF8\uB2E4.\n\n\u201C\uADF8
      \uC815\uB3C4 \uB188\uB4E4\uC744 \uC4F0\uB7EC\uB728\uB838\uB2E4\uBA74, \uB0B4
      \uC190\uC744 \uBE4C\uB9B4 \uC790\uACA9\uC740 \uC788\uACA0\uC9C0.\u201D"
    m_Metadata:
      m_Items: []
