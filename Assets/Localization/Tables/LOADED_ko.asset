    m_Metadata:
      m_Items: []
  - m_Id: 970523549
    m_Localized: "COUNT \uC885\uB8CC \uC2DC \uD604\uC7AC \uC2A4\uD0DD\uB9CC\uD07C
      {0}\uB97C \uBC1B\uACE0 {1}\uD569\uB2C8\uB2E4.\n\n\uD604\uC7AC {2}: {3} \uB3D9\uC548
      \uB3C5\uC758 \uB300\uBBF8\uC9C0\uB97C \uBC1B\uC2B5\uB2C8\uB2E4. {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523550
    m_Localized: "\uC774\uBC88 COUNT \uD53C\uD574\uB7C9: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523551
    m_Localized: "{0} \uC0C1\uD0DC\uC774\uBA70 COUNT\uB9C8\uB2E4 {1}\uD569\uB2C8\uB2E4.\n\n\uD604\uC7AC
      {2}: {3} \uB3D9\uC548 {4}."
    m_Metadata:
      m_Items: []
  - m_Id: 970523552
    m_Localized: "{0}\uC774 {1}\uD569\uB2C8\uB2E4.\n\n\uD604\uC7AC {2}: {3} \uB3D9\uC548
      {4}\uC774 {5}\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523553
    m_Localized: "\uB2E4\uC74C {0}\uC774 {1}\uB429\uB2C8\uB2E4.\n\n\uD55C \uBC88
      \uD53C\uACA9\uB418\uAC70\uB098, \uACF5\uACA9\uD558\uC9C0 \uC54A\uACE0 \uB2E4\uB978
      \uD589\uB3D9\uC744 \uD558\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523554
    m_Localized: DUEL CLOCK
    m_Metadata:
      m_Items: []
  - m_Id: 970523555
    m_Localized: DUEL CLOCK
    m_Metadata:
      m_Items: []
  - m_Id: 970523556
    m_Localized: "\uCE58\uBA85 \uD53C\uD574 1\uD68C \uBC29\uC9C0, \uCCB4\uB825 {0}
      \uC720\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 970523557
    m_Localized: "\uC774\uB3D9 1\uCE78\uB2F9 \uB2E4\uC74C \uACF5\uACA9 \uCD5C\uC885
      \uD53C\uD574 x{0}\n\uC2A4\uD0DD \uC18C\uBAA8: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523558
    m_Localized: "\uC2E4\uB9B0\uB354 \uCCAB \uC0AC\uACA9 \uCD5C\uC885 \uD53C\uD574
      x{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523559
    m_Localized: "\uC2E4\uB9B0\uB354 \uB9C8\uC9C0\uB9C9 \uC0AC\uACA9 \uCD5C\uC885
      \uD53C\uD574 x{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523560
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uB2E4\uC74C \uC7A5\uC804 \uD0C4\uD658
      1\uBC1C \uCD5C\uC885 \uD53C\uD574 x{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523561
    m_Localized: "\uD53C\uD574 \uC2DC \uB4A4\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
      \uC801\uC5D0\uAC8C \uD53C\uD574 {0}% \uC804\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 970523562
    m_Localized: "\uB514\uBC84\uD504 \uBCF4\uC720 \uC801 \uB300\uC0C1 \uCD5C\uC885
      \uD53C\uD574 x{0}\n\uD574\uB2F9 \uC801 \uCC98\uCE58 \uC2DC \uB514\uBC84\uD504
      {1}%\uB97C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uC774\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 970523563
    m_Localized: "\uC7AC\uC7A5\uC804 \uC2DC DUEL CLOCK \uCDA9\uC804 \uC5C6\uC74C
      ({0}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 970523564
    m_Localized: "\uC2E4\uB9B0\uB354 \uB0B4 \uBAA8\uB4E0 \uC801 \uACF5\uACA9 \uC2DC
      \uCD5C\uACE0 \uB2E8\uC77C \uD53C\uD574\uC758 {0}%\uB97C \uC0DD\uC874 \uC801
      \uC804\uCCB4\uC5D0 \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 970523565
    m_Localized: "\uBC1C\uCC28\uAE30 \uD53C\uD574 x{0}\n{1}\uCE78 \uC774\uB3D9\uB9C8\uB2E4
      \uBB34\uB8CC \uC7AC\uC7A5\uC804 +1 (\uCD5C\uB300 {2}\uD68C \uC800\uC7A5)"
    m_Metadata:
      m_Items: []
  - m_Id: 970523566
    m_Localized: "\uC801 \uCC98\uCE58 \uACE8\uB4DC x{0} ({1}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 970523567
    m_Localized: "\uD0C4\uD658 \uBC1C\uC0AC \uC2DC \uCD94\uAC00 \uBC1C\uC0AC ({0}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 970523568
    m_Localized: "\uC0DD\uC874 \uC801 \uC218\uAC00 \uC801\uC744\uC218\uB85D \uCD5C\uC885
      \uD53C\uD574 \uC99D\uAC00\n\uC99D\uAC00\uB7C9: max(0, {0}-{1}\xD7\uC801 \uC218)%"
    m_Metadata:
      m_Items: []
  - m_Id: 970523569
    m_Localized: "\uBCF4\uC2A4 \uCC98\uCE58 \uC2DC \uBAA8\uB4E0 \uD0C4\uD658 \uCD5C\uC885
      \uD53C\uD574 \uC601\uAD6C +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 970523570
    m_Localized: "6\uBC1C \uC7A5\uC804 \uC2DC \uBB34\uC791\uC704 \uD0C4\uD658 1\uBC1C\uC758
      \uCD5C\uC885 \uD53C\uD574 x{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523571
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uB2E4\uC74C \uD0C4\uD658 \uCD5C\uC885
      \uD53C\uD574 x{0}\n\uC5F0\uC18D \uCC98\uCE58 \uC2DC \uD6A8\uACFC \uC720\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 970523572
    m_Localized: "\uB514\uBC84\uD504 \uBCF4\uC720 \uC801 \uBA85\uC911 \uC2DC \uBB34\uC791\uC704
      \uB514\uBC84\uD504 +1 ({0}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 970523573
    m_Localized: "\uCCB4\uB825 {0}% \uC774\uD558: \uBAA8\uB4E0 \uD0C4\uD658 \uCD5C\uC885
      \uD53C\uD574 x{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523574
    m_Localized: "\uBAA8\uB4E0 \uD0C4\uD658 \uC0AC\uAC70\uB9AC +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523575
    m_Localized: "\uC774\uB3D9 \uC2DC DUEL CLOCK \uCDA9\uC804 \uC5C6\uC74C ({0}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 970523576
    m_Localized: "\uD6A8\uACFC \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 970523577
    m_Localized: "\uC0AC\uACA9 \uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 970523578
    m_Localized: "\uC2E4\uB9B0\uB354 \uC885\uB8CC \uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 970523579
    m_Localized: "\uB2E4\uC74C \uC804\uD22C \uC2DC\uC791 \uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 970523580
    m_Localized: "\uC18C\uBE44\uD558\uC9C0 \uC54A\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 970523581
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC811\uADFC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523582
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C\uC11C \uBB3C\uB7EC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523583
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uBC29\uD5A5\uC73C\uB85C \uD68C\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523584
    m_Localized: "\uC774\uBC88 COUNT\uC5D0\uB294 \uD589\uB3D9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523585
    m_Localized: "\uC544\uAD70\uC744 \uC9C0\uC6D0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523586
    m_Localized: "\uACE0\uC815\uB41C \uD0C0\uC77C\uC5D0 \uD3ED\uD0C4\uC744 \uD22C\uCC99\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523587
    m_Localized: "\uBCF4\uC2A4\uC758 \uD604\uC7AC \uC704\uCE58 \uC591\uC606 \uD0C0\uC77C\uC744
      \uB3D9\uC2DC\uC5D0 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523588
    m_Localized: "\uB2E4\uC74C \uACF5\uACA9\uC744 \uC704\uD574 \uC7AC\uC7A5\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523589
    m_Localized: "\uACF5\uACA9\uC744 \uC2E4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523590
    m_Localized: "\uD53C\uD574 {0}, \uC0AC\uAC70\uB9AC {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 970523591
    m_Localized: "\uB300\uBBF8\uC9C0: <color=red> {0} </color> \uC0AC\uAC70\uB9AC:
      <color=yellow>{1}</color>"
    m_Metadata:
      m_Items: []
