      m_Items: []
  - m_Id: 966328560
    m_Localized: "\uBCA0\uD14C\uB791 \uD22C\uCC99\uBCD1\uC774 \uAC15\uD654 \uD654\uC5FC\uBCD1\uC744
      \uB358\uC838 \uD53C\uD574 22\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328561
    m_Localized: "\uAC15\uD654 \uD654\uC5FC\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 966328562
    m_Localized: "\uD050\uC5D0 \uB4F1\uB85D\uD55C \uB4A4 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
      \uC778\uC811\uD560 \uB54C\uAE4C\uC9C0 \uC811\uADFC\uD558\uC5EC \uC591\uC606
      \uD0C0\uC77C\uC744 \uB3D9\uC2DC\uC5D0 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328563
    m_Localized: "\uC0B0\uD0C4 \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 966328564
    m_Localized: "\uD3ED\uD0C4 \uD22C\uCC99 \uD328\uD134\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30
      \uC804\uC5D0 \uC7AC\uC7A5\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328565
    m_Localized: "\uC7AC\uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 966328566
    m_Localized: "1\uD398\uC774\uC988\uC5D0\uB294 2\uAC1C, 2\uD398\uC774\uC988\uC5D0\uB294
      3\uAC1C\uB97C \uD050\uC5D0 \uCDA9\uC804\uD55C \uB4A4 \uBB34\uC791\uC704 \uD0C0\uC77C\uC5D0
      \uC2DC\uD55C\uD3ED\uD0C4\uC744 \uD22C\uCC99\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328567
    m_Localized: "\uD3ED\uD0C4 \uD22C\uCC99"
    m_Metadata:
      m_Items: []
  - m_Id: 966328568
    m_Localized: "\uD654\uC5FC\uBCD1\uC744 \uB358\uC838 \uBAA9\uD45C \uD0C0\uC77C\uC5D0
      \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 966328569
    m_Localized: "\uD654\uC5FC\uBCD1 \uB358\uC9C0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 966328570
    m_Localized: "\uC6D0\uAC70\uB9AC \uACF5\uACA9\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328571
    m_Localized: "\uBCA0\uD14C\uB791 \uCD1D\uC7A1\uC774\uAC00 \uC815\uBC00\uD558\uAC8C
      \uC870\uC900\uD574 \uD53C\uD574 22\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328572
    m_Localized: "\uC815\uBC00 \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 966328573
    m_Localized: "\uBD80\uC0C1\uB2F9\uD55C \uC544\uAD70\uC744 \uD68C\uBCF5\uD558\uAC70\uB098
      \uCD5C\uC804\uC120 \uC544\uAD70\uC5D0\uAC8C \uBCF4\uD638\uB9C9\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328574
    m_Localized: "\uBCA0\uD14C\uB791 \uCE7C\uC7A1\uC774\uAC00 \uAC15\uD558\uAC8C
      \uBCA0\uC5B4 \uD53C\uD574 15\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328575
    m_Localized: "\uAC15\uD55C \uBCA0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 966328576
    m_Localized: "\uADFC\uC811 \uACF5\uACA9\uC744 \uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328577
    m_Localized: "\uBCA0\uD14C\uB791 \uCE7C\uC7A1\uC774\uAC00 \uAC15\uD558\uAC8C
      \uBCA0\uC5B4 \uD53C\uD574 15\uB97C \uC90D\uB2C8\uB2E4."
