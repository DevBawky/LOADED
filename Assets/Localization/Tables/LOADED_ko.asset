  - m_Id: 966328594
    m_Localized: "\uB178\uB828\uD55C \uC870\uC900\uC73C\uB85C \uB354 \uC704\uB825\uC801\uC778
      \uC0AC\uACA9\uC744 \uAC00\uD558\uB294 \uCD1D\uC7A1\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 966328595
    m_Localized: "\uBCA0\uD14C\uB791 \uCD1D\uC7A1\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 966328596
    m_Localized: "\uC2DC\uD55C\uD3ED\uD0C4\uACFC \uC591\uC606 \uC0B0\uD0C4 \uC0AC\uACA9\uC744
      \uACE0\uC815 \uC21C\uC11C\uB85C \uC0AC\uC6A9\uD558\uB294 \uC2A4\uD14C\uC774\uC9C0
      1 \uBCF4\uC2A4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328597
    m_Localized: "\uD3ED\uC57D\uC655 \uBE45 \uBCA0\uB7F4"
    m_Metadata:
      m_Items: []
  - m_Id: 966328598
    m_Localized: "\uD22C\uCC99\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 966328599
    m_Localized: "\uAC70\uCE5C \uC2F8\uC6C0\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC544
      \uB354 \uB2E8\uB2E8\uD558\uACE0 \uAC15\uD55C \uACF5\uACA9\uC744 \uC0AC\uC6A9\uD558\uB294
      \uCE7C\uC7A1\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 966328600
    m_Localized: "\uBCA0\uD14C\uB791 \uCE7C\uC7A1\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 966328601
    m_Localized: Test Enemy
    m_Metadata:
      m_Items: []
  - m_Id: 966328602
    m_Localized: "\uAC15\uD654\uB41C \uD654\uC5FC\uBCD1\uC73C\uB85C \uB354 \uD070
      \uD53C\uD574\uB97C \uB178\uB9AC\uB294 \uD22C\uCC99\uBCD1."
    m_Metadata:
      m_Items: []
  - m_Id: 966328603
    m_Localized: "\uBCA0\uD14C\uB791 \uD22C\uCC99\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 966328604
    m_Localized: "\uCD1D\uC7A1\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 966328605
    m_Localized: "\uC544\uAD70\uC744 \uD68C\uBCF5\uD558\uAC70\uB098 \uBCF4\uD638\uB9C9\uC744
      \uC8FC\uB294 \uC9C0\uC6D0\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 966328606
    m_Localized: "\uC9C0\uAC8C\uAFBC"
    m_Metadata:
      m_Items: []
  - m_Id: 966328607
    m_Localized: "[\uBC1B\uB294\uB2E4] \uD0C4\uD658\uC744 \uD55C \uBC1C \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328608
    m_Localized: "\uD589\uC0C1\uC778\uC740 \uC9E7\uAC8C \uC6C3\uACE0 \uD0C4\uD658\uC744
      \uAC74\uB138\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328609
    m_Localized: "\uD0C4\uD658 \uBCF4\uC720 \uD55C\uB3C4\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328610
    m_Localized: "\uB354 \uC774\uC0C1 \uC774 \uC120\uD0DD\uC9C0\uB97C \uACE0\uB97C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328611
    m_Localized: "[\uB5A0\uB09C\uB2E4] \uB300\uC2E0 \uC5EC\uBE44\uB97C \uCC59\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328612
    m_Localized: "\uB2F9\uC2E0\uC740 \uC791\uC740 \uB3C8\uC8FC\uBA38\uB2C8\uB9CC
      \uCC59\uACA8 \uAE38\uC744 \uC7AC\uCD09\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328613
    m_Localized: "\uB354 \uC774\uC0C1 \uC774 \uC120\uD0DD\uC9C0\uB97C \uACE0\uB97C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328614
    m_Localized: "\uC0C1\uC778\uC740 \uB0A1\uC740 \uD0C4\uD658 \uD558\uB098\uB97C
      \uC190\uAC00\uB77D \uC0AC\uC774\uC5D0\uC11C \uAD74\uB9AC\uBA70 \uB2F9\uC2E0\uC744
      \uBC14\uB77C\uBCF8\uB2E4.\n\n\u201C\uB9C8\uC744 \uC0C1\uC810\uC5D0\uB294 \uB4E4\uB974\uC9C0\uB3C4
      \uC54A\uC558\uAD70. \uC774\uAC74 \uB0B4\uAC00 \uB9E1\uC544 \uB450\uAE30\uC5D4
      \uC544\uAE4C\uC6B4 \uBB3C\uAC74\uC774\uC57C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 966328615
    m_Localized: "\uAE38 \uC783\uC740 \uD589\uC0C1\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 966328616
    m_Localized: "[\uD53C\uB97C \uB0B4\uC900\uB2E4] \uD604\uC7AC HP\uC758 50%\uB97C
      \uC783\uACE0 \uBB34\uC791\uC704 \uD0C4\uD658 3\uAC1C \uC911 \uD558\uB098\uB97C
      \uACE0\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328617
    m_Localized: "\uC794\uC774 \uCC28\uC624\uB974\uC790 \uC545\uB9C8\uAC00 \uD0C4\uD658
      \uC138 \uBC1C\uC744 \uD0C1\uC790 \uC704\uC5D0 \uAD74\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328618
    m_Localized: "\uD0C4\uD658 \uBCF4\uC720 \uACF5\uAC04\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328619
    m_Localized: "\uB354 \uC774\uC0C1 \uC774 \uC120\uD0DD\uC9C0\uB97C \uACE0\uB97C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328620
    m_Localized: "[\uAC70\uC808\uD55C\uB2E4] \uBAA9\uB35C\uBBF8\uB97C \uAC00\uB9AC\uACE0
      \uC790\uB9AC\uB97C \uB72C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328621
    m_Localized: "\uC545\uB9C8\uB294 \uB2E4\uC74C \uC190\uB2D8\uC744 \uAE30\uB2E4\uB9AC\uBA70
      \uBE48 \uC794\uC744 \uB2E6\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328622
    m_Localized: "\uB354 \uC774\uC0C1 \uC774 \uC120\uD0DD\uC9C0\uB97C \uACE0\uB97C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328623
    m_Localized: "\uC545\uB9C8\uB294 \uBE48 \uC794 \uC138 \uAC1C\uB97C \uB298\uC5B4\uB193\uACE0
      \uC785\uC220\uC744 \uD565\uB294\uB2E4.\n\n\u201C\uB124 \uD53C \uBC18 \uC794\uC774\uBA74,
      \uB0B4 \uD0C4\uD658 \uC911 \uD558\uB098\uB97C \uACE0\uB974\uAC8C \uD574 \uC8FC\uC9C0.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 966328624
    m_Localized: "\uD761\uD608 \uC545\uB9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 966328625
    m_Localized: "[\uB4F1\uAC00\uAD50\uD658] \uAC19\uC740 \uB4F1\uAE09\uC758 \uC11C\uB85C
      \uB2E4\uB978 \uD0C4\uD658 2\uAC1C\uB97C \uB118\uAE30\uACE0, \uAC19\uC740 \uB4F1\uAE09\uC758
      \uBB34\uC791\uC704 \uD0C4\uD658\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328626
    m_Localized: "\uB0A8\uC790\uB294 \uB450 \uBC1C\uC744 \uC0BC\uD0A4\uB4EF \uCC59\uAE30\uACE0
      \uAC19\uC740 \uC0C9 \uD14C\uB450\uB9AC\uC758 \uD0C4\uD658\uC744 \uB358\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328627
    m_Localized: "\uAD50\uD658 \uB4A4\uC5D0\uB3C4 \uD0C4\uD658\uC744 1\uAC1C \uC774\uC0C1
      \uB0A8\uACA8\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328628
    m_Localized: "\uB354 \uC774\uC0C1 \uC774 \uC120\uD0DD\uC9C0\uB97C \uACE0\uB97C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328629
    m_Localized: "[\uD55C \uB2E8\uACC4 \uC704\uB97C \uB178\uB9B0\uB2E4] \uAC19\uC740
