    m_Localized: "\uBCF4\uC720 \uB371\uC5D0\uC11C \uAC00\uC7A5 \uB9CE\uC740 \uB4F1\uAE09\uC758
      \uD0C4\uD658 \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574 +75%"
