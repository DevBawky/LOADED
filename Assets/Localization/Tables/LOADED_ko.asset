  - m_Id: 966328873
    m_Localized: "\uD0C4\uD658\uC758 \uC7A5\uC804 \uC21C\uC11C\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 966328874
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C\uB294 \uB2E4\uC74C \uC804\uD22C\uB97C
      \uBBF8\uB9AC \uC900\uBE44\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328875
    m_Localized: "\uC704\uD5D8\uD55C \uC801\uBD80\uD130 \uC81C\uAC70\uD558\uBA74
      \uD53C\uD574\uB97C \uC904\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328876
    m_Localized: "\uD0C4\uD658 \uD6A8\uACFC\uC758 \uC870\uD569\uC774 \uC804\uD22C\uC758
      \uD750\uB984\uC744 \uBC14\uAFC9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328877
    m_Localized: "\uC5EC\uC815\uC774 \uC2DC\uC791\uB418\uB294 \uC9C0\uC810\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328878
    m_Localized: "\uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 966328879
    m_Localized: "\uC77C\uBC18 \uC801\uB4E4\uACFC \uC804\uD22C\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328880
    m_Localized: "\uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 966328881
    m_Localized: "\uB354\uC6B1 \uAC15\uB825\uD55C \uC815\uC608 \uC801\uB4E4\uACFC
      \uC804\uD22C\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328882
    m_Localized: "\uC815\uC608 \uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 966328883
    m_Localized: "\uD0C4\uD658\uC744 \uAD6C\uB9E4/\uD310\uB9E4/\uAC15\uD654 \uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC18C\uBAA8\uD615 \uC544\uC774\uD15C\uC744
      \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328884
    m_Localized: "\uC0C1\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 966328885
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790\uB97C \uC5F4\uC5B4 \uC720\uBB3C\uC744
      \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328886
    m_Localized: "\uBCF4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 966328887
    m_Localized: "\uD2B9\uBCC4\uD55C \uC0AC\uAC74\uACFC \uC120\uD0DD\uC9C0\uB97C
      \uB9C8\uC8FC\uD569\uB2C8\uB2E4.\n<color=red>\uC804\uD22C</color> \uB610\uB294
      <color=red>\uC0C1\uC810</color>\uC774 \uB098\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328888
    m_Localized: "\uC774\uBCA4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 966328889
    m_Localized: "\uC2A4\uD14C\uC774\uC9C0\uC758 \uBCF4\uC2A4\uC640 \uACB0\uC804\uC744
      \uCE58\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 966328890
    m_Localized: "\uBCF4\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 966328891
    m_Localized: "\uC774\uB3D9 \uC2DC \uD134 \uC18C\uBAA8 \uC5C6\uC74C (20%)"
    m_Metadata:
      m_Items: []
  - m_Id: 966328892
    m_Localized: "\uC9C8\uC8FC\uC758 \uBC15\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 966328893
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uB2E4\uC74C \uC7A5\uC804 \uD0C4\uD658
      1\uBC1C \uCD5C\uC885 \uD53C\uD574 x1.12"
    m_Metadata:
      m_Items: []
  - m_Id: 966328894
    m_Localized: "\uD3EC\uC2DD\uC790\uC758 \uD640\uC2A4\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 966328895
    m_Localized: "\uD53C\uD574 \uC2DC \uB4A4\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
      \uC801\uC5D0\uAC8C \uD53C\uD574 20% \uC804\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 966328896
    m_Localized: "\uD3D0\uC1C4 \uD68C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 966328897
    m_Localized: "\uB514\uBC84\uD504 \uBCF4\uC720 \uC801 \uB300\uC0C1 \uCD5C\uC885
      \uD53C\uD574 x1.05\n\uD574\uB2F9 \uC801 \uCC98\uCE58 \uC2DC \uB514\uBC84\uD504
      50%\uB97C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uC774\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 966328898
    m_Localized: "\uAC10\uC5FC\uC131 \uBC30\uC591\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 966328899
    m_Localized: "\uC7AC\uC7A5\uC804 \uC2DC \uD134 \uC18C\uBAA8 \uC5C6\uC74C (30%)"
    m_Metadata:
      m_Items: []
  - m_Id: 966328900
    m_Localized: "\uBE48 \uBC15\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 966328901
    m_Localized: "\uC804\uC7A5 \uB0B4 \uBAA8\uB4E0 \uC801 \uACF5\uACA9 \uC2DC \uCD5C\uACE0
      \uB2E8\uC77C \uD53C\uD574\uC758 40%\uB97C \uC0DD\uC874 \uC801 \uC804\uCCB4\uC5D0
      \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 966328902
    m_Localized: "\uD3ED\uD48D\uC758 \uB208"
    m_Metadata:
      m_Items: []
  - m_Id: 966328903
    m_Localized: "\uBC1C\uCC28\uAE30 \uD53C\uD574 x1.5\n5\uCE78 \uC774\uB3D9\uB9C8\uB2E4
      \uBB34\uB8CC \uC7AC\uC7A5\uC804 +1 (\uCD5C\uB300 2\uD68C \uC800\uC7A5)"
    m_Metadata:
      m_Items: []
  - m_Id: 966328904
    m_Localized: "\uB9C8\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 966328905
    m_Localized: "\uC801 \uCC98\uCE58 \uACE8\uB4DC x7 (5%)"
    m_Metadata:
      m_Items: []
  - m_Id: 966328906
    m_Localized: "\uC0AC\uAE08 \uC120\uBCC4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 966328907
    m_Localized: "\uD0C4\uD658 \uBC1C\uC0AC \uC2DC \uCD94\uAC00 \uBC1C\uC0AC (10%)"
    m_Metadata:
      m_Items: []
  - m_Id: 966328908
    m_Localized: "\uAE08\uC774 \uAC04 \uB1CC\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 966328909
    m_Localized: "\uC0DD\uC874 \uC801 \uC218\uAC00 \uC801\uC744\uC218\uB85D \uCD5C\uC885
      \uD53C\uD574 \uC99D\uAC00\n\uC99D\uAC00\uB7C9: max(0, 15-3\xD7\uC801 \uC218)%"
    m_Metadata:
      m_Items: []
  - m_Id: 966328910
    m_Localized: "\uC800\uC6B8"
    m_Metadata:
      m_Items: []
  - m_Id: 966328911
    m_Localized: "\uBCF4\uC2A4 \uCC98\uCE58 \uC2DC \uBAA8\uB4E0 \uD0C4\uD658 \uCD5C\uC885
      \uD53C\uD574 \uC601\uAD6C +5%"
    m_Metadata:
      m_Items: []
  - m_Id: 966328912
    m_Localized: "\uAC00\uBB38\uC758 \uC720\uC5B8\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 966328913
    m_Localized: "6\uBC1C \uC7A5\uC804 \uC2DC \uBB34\uC791\uC704 \uD0C4\uD658 1\uBC1C\uC758
      \uCD5C\uC885 \uD53C\uD574 x2"
    m_Metadata:
      m_Items: []
  - m_Id: 966328914
    m_Localized: "\uD589\uC6B4\uC758 \uC57D\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 966328915
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uB2E4\uC74C \uD0C4\uD658 \uCD5C\uC885
      \uD53C\uD574 x1.15\n\uC5F0\uC18D \uCC98\uCE58 \uC2DC \uD6A8\uACFC \uC720\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 966328916
    m_Localized: "\uCC98\uD615\uC790\uC758 \uC11C\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 966328917
    m_Localized: "\uB514\uBC84\uD504 \uBCF4\uC720 \uC801 \uBA85\uC911 \uC2DC \uBB34\uC791\uC704
      \uB514\uBC84\uD504 +1 (40%)"
    m_Metadata:
      m_Items: []
  - m_Id: 966328918
    m_Localized: "\uBCC0\uC774 \uCD09\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 966328919
    m_Localized: "\uCCB4\uB825 25% \uC774\uD558: \uBAA8\uB4E0 \uD0C4\uD658 \uCD5C\uC885
      \uD53C\uD574 x1.2"
    m_Metadata:
      m_Items: []
  - m_Id: 966328920
    m_Localized: "\uBCBC\uB791 \uB05D\uC758 \uBC29\uC544\uC1E0"
    m_Metadata:
      m_Items: []
  - m_Id: 966328921
    m_Localized: "\uBAA8\uB4E0 \uD0C4\uD658 \uC0AC\uAC70\uB9AC +1"
    m_Metadata:
      m_Items: []
  - m_Id: 966328922
    m_Localized: "\uCD5C\uACE0\uAE09 \uC870\uC900\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 966328923
    m_Localized: "\uC2E4\uB9B0\uB354 \uCCAB \uC0AC\uACA9 \uCD5C\uC885 \uD53C\uD574
      x1.3"
    m_Metadata:
      m_Items: []
  - m_Id: 966328924
    m_Localized: "\uCD08\uD0C4 \uC870\uC900\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 966328925
    m_Localized: "\uC2E4\uB9B0\uB354 \uB9C8\uC9C0\uB9C9 \uC0AC\uACA9 \uCD5C\uC885
      \uD53C\uD574 x1.3"
    m_Metadata:
      m_Items: []
  - m_Id: 966328926
    m_Localized: "\uCD5C\uD6C4\uC758 \uD0C4\uD53C"
    m_Metadata:
      m_Items: []
  - m_Id: 966328927
    m_Localized: "\uCE58\uBA85 \uD53C\uD574 1\uD68C \uBC29\uC9C0, \uCCB4\uB825 1
