  - m_Id: 974717159
    m_Localized: "\uC2B9\uB9AC (\uC2B9\uB960) :"
    m_Metadata:
      m_Items: []
  - m_Id: 974717160
    m_Localized: "\uC720\uBB3C \uBCF4\uAD00\uD568\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717161
    m_Localized: "\uC774 \uC720\uBB3C\uC744 \uD68D\uB4DD\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717162
    m_Localized: "{0}\uC744(\uB97C) \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717163
    m_Localized: "\uD68D\uB4DD\uD560 \uC218 \uC788\uB294 \uC720\uBB3C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717164
    m_Localized: "\uC0C1\uC790\uB97C \uD074\uB9AD\uD574 \uC5EC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 974717165
    m_Localized: "\uAC00\uC838\uAC08 \uC720\uBB3C \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 974717166
    m_Localized: "\uC5F4\uB9B0 \uBCF4\uBB3C \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 974717167
    m_Localized: "\uBCF4\uBB3C \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 974717168
    m_Localized: "\uBCF4\uBB3C \uB370\uC774\uD130\uB97C \uBD88\uB7EC\uC62C \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717169
    m_Localized: "\uBCF4\uBB3C \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 974717170
    m_Localized: "\uB178\uB4DC\uB9F5\uC73C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717171
    m_Localized: "\uD3ED\uD0C4 \uD22C\uCC99"
    m_Metadata:
      m_Items: []
  - m_Id: 974717172
    m_Localized: "\uACE0\uC815\uB41C \uBB34\uC791\uC704 \uD0C0\uC77C\uC5D0 \uC2DC\uD55C\uD3ED\uD0C4\uC744
      \uD22C\uCC99\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717173
    m_Localized: "\uC0B0\uD0C4 \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717174
    m_Localized: "\uBCF4\uC2A4\uC758 \uD604\uC7AC \uC704\uCE58 \uC591\uC606 \uD0C0\uC77C\uC744
      \uB3D9\uC2DC\uC5D0 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717175
    m_Localized: "\uC7AC\uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717176
    m_Localized: "\uD3ED\uD0C4 \uD22C\uCC99 \uD328\uD134\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD558\uAE30
      \uC804\uC5D0 \uC7AC\uC7A5\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717177
    m_Localized: "\uD3ED\uC57D\uC655 \uBE45 \uBCA0\uB7F4"
    m_Metadata:
      m_Items: []
  - m_Id: 974717178
    m_Localized: "\uC2DC\uD55C\uD3ED\uD0C4\uACFC \uC591\uC606 \uC0B0\uD0C4 \uC0AC\uACA9\uC744
      \uACE0\uC815 \uC21C\uC11C\uB85C \uC0AC\uC6A9\uD558\uB294 \uC2A4\uD14C\uC774\uC9C0
      1 \uBCF4\uC2A4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717179
    m_Localized: "\uD3ED\uC57D\uC655 \uBE45 \uBCA0\uB7F4"
    m_Metadata:
      m_Items: []
  - m_Id: 974717180
    m_Localized: "\uD3ED\uC57D\uC655 \uBE45 \uBCA0\uB7F4\uC744 \uCC98\uCE58\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717181
    m_Localized: "\uAE30\uBCF8 \uC815\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 974717182
    m_Localized: "Avatar \uBCC0\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 974717183
    m_Localized: "\uC804\uD22C \uB2A5\uB825\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 974717184
    m_Localized: "AI \uD589\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717185
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC811\uADFC\uD574 \uACF5\uACA9\uC744
      \uC608\uACE0\uD558\uACE0, \uACF5\uACA9 \uB4A4 \uC120\uD638 \uAC70\uB9AC\uAE4C\uC9C0
      \uBB3C\uB7EC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717186
    m_Localized: "\uACF5\uACA9 \uD0C0\uC77C\uC744 \uBA3C\uC800 \uB4F1\uB85D\uD55C
      \uB4A4, \uC124\uC815\uB41C \uC0AC\uAC70\uB9AC \uC548\uAE4C\uC9C0 \uC811\uADFC\uD569\uB2C8\uB2E4.
      \uC0AC\uC120\uC774 \uD655\uBCF4\uB418\uBA74 \uACF5\uACA9\uC744 \uC900\uBE44\uD558\uACE0
      \uB2E4\uC74C COUNT\uC5D0 \uC0AC\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717187
    m_Localized: "\uC0AC\uAC70\uB9AC\uB294 \uBCF4\uB4DC \uC804\uCCB4\uC785\uB2C8\uB2E4.
      \uC900\uBE44 \uC21C\uAC04\uC758 \uD50C\uB808\uC774\uC5B4 \uD0C0\uC77C\uC744
      \uACE0\uC815\uD55C \uB4A4 \uD22C\uCC99\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717188
    m_Localized: "\uAC70\uB9AC \uC81C\uD55C \uC5C6\uC774 \uBD80\uC0C1\uB2F9\uD55C
      \uC544\uAD70\uC744 \uD68C\uBCF5\uD558\uACE0, \uD68C\uBCF5 \uB300\uC0C1\uC774
      \uC5C6\uC73C\uBA74 \uCD5C\uC804\uC120 \uC544\uAD70\uC5D0\uAC8C \uBCF4\uD638\uB9C9\uC744
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717189
    m_Localized: "\uACE0\uC815 \uC21C\uC11C\uB85C \uD3ED\uD0C4 \uD22C\uCC99, \uAC70\uB9AC
      \uC870\uC815, \uC591\uC606 \uC0B0\uD0C4 \uC0AC\uACA9, \uC7AC\uC7A5\uC804\uC744
      \uBC18\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717190
    m_Localized: "\uD589\uB3D9 \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 974717191
    m_Localized: "\uC608\uACE0\uC120 \uACF5\uD1B5 \uC124\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 974717192
    m_Localized: "\uCC98\uCE58 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 974717193
    m_Localized: "\uACE8\uB4DC\uB294 \uCC98\uCE58 \uC2DC \uD56D\uC0C1 \uC9C0\uAE09\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717194
    m_Localized: "Enemy ID\uB97C \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717195
    m_Localized: "\uC801 Avatar \uD504\uB9AC\uD339\uC774 \uC5F0\uACB0\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717196
    m_Localized: "Avatar \uD504\uB9AC\uD339\uC5D0 Animator\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717197
    m_Localized: "Avatar\uC758 Animator Controller\uAC00 \uC5F0\uACB0\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717198
    m_Localized: "{0} \uD589\uB3D9\uC744 \uCD5C\uC18C \uD558\uB098 \uC5F0\uACB0\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717199
    m_Localized: "\uD3ED\uD0C4 \uD22C\uCC99"
    m_Metadata:
      m_Items: []
  - m_Id: 974717200
    m_Localized: "\uC0B0\uD0C4 \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717201
    m_Localized: "\uC7AC\uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717202
    m_Localized: "BossBomb \uD504\uB9AC\uD339\uC774 \uC5F0\uACB0\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717203
    m_Localized: "BossBomb \uD504\uB9AC\uD339 \uB8E8\uD2B8\uC5D0 BossBomb \uCEF4\uD3EC\uB10C\uD2B8\uAC00
      \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717204
    m_Localized: "\uD3ED\uD0C4 \uD53C\uD574\uB7C9\uC740 0\uBCF4\uB2E4 \uCEE4\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717205
    m_Localized: "\uD3ED\uBC1C \uBC94\uC704\uB294 0\uBCF4\uB2E4 \uCEE4\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717206
    m_Localized: "\uBAA8\uB4E0 \uD3ED\uD0C4 \uD4E8\uC988\uB294 1\uC5D0\uC11C 3 \uC0AC\uC774\uC5EC\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717207
    m_Localized: "2\uD398\uC774\uC988 \uCCB4\uB825 \uBE44\uC728\uC740 0\uACFC 1 \uC0AC\uC774\uC5EC\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717208
    m_Localized: "{0} Action\uC774 \uC5F0\uACB0\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717209
    m_Localized: "\uAC15\uD55C \uBCA0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717210
    m_Localized: "\uBCA0\uD14C\uB791 \uCE7C\uC7A1\uC774\uAC00 \uAC15\uD558\uAC8C
      \uBCA0\uC5B4 \uD53C\uD574 15\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717211
    m_Localized: "\uC815\uBC00 \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717212
    m_Localized: "\uBCA0\uD14C\uB791 \uCD1D\uC7A1\uC774\uAC00 \uC815\uBC00\uD558\uAC8C
      \uC870\uC900\uD574 \uD53C\uD574 22\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717213
    m_Localized: "\uAC15\uD654 \uD654\uC5FC\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 974717214
    m_Localized: "\uBCA0\uD14C\uB791 \uD22C\uCC99\uBCD1\uC774 \uAC15\uD654 \uD654\uC5FC\uBCD1\uC744
      \uB358\uC838 \uD53C\uD574 22\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717215
    m_Localized: "\uBCA0\uD14C\uB791 \uCE7C\uC7A1\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 974717216
    m_Localized: "\uAC70\uCE5C \uC2F8\uC6C0\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC544
      \uB354 \uB2E8\uB2E8\uD558\uACE0 \uAC15\uD55C \uACF5\uACA9\uC744 \uC0AC\uC6A9\uD558\uB294
      \uCE7C\uC7A1\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 974717217
    m_Localized: "\uBCA0\uD14C\uB791 \uCD1D\uC7A1\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 974717218
    m_Localized: "\uB178\uB828\uD55C \uC870\uC900\uC73C\uB85C \uB354 \uC704\uB825\uC801\uC778
      \uC0AC\uACA9\uC744 \uAC00\uD558\uB294 \uCD1D\uC7A1\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 974717219
    m_Localized: "\uBCA0\uD14C\uB791 \uD22C\uCC99\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 974717220
    m_Localized: "\uAC15\uD654\uB41C \uD654\uC5FC\uBCD1\uC73C\uB85C \uB354 \uD070
      \uD53C\uD574\uB97C \uB178\uB9AC\uB294 \uD22C\uCC99\uBCD1."
    m_Metadata:
      m_Items: []
