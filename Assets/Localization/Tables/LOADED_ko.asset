    m_Metadata:
      m_Items: []
  - m_Id: 970523396
    m_Localized: "\uC7A5\uC804 \uC2DC DUEL CLOCK\uC744 \uCDA9\uC804\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523397
    m_Localized: "\uAD00\uD1B5 \uD655\uB960\uC5D0 \uB530\uB77C \uB4A4\uCABD \uC801\uC744
      \uCD94\uAC00\uB85C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523398
    m_Localized: "\uBC29\uD5A5\uACFC \uAD00\uACC4\uC5C6\uC774 \uC0DD\uC874\uD55C
      \uBAA8\uB4E0 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523399
    m_Localized: "\uD0C4\uD658 1\uBC1C\uC744 \uC18C\uBAA8\uD558\uC5EC \uD55C \uBC88\uC5D0
      {0}\uBC1C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523400
    m_Localized: "\uAD00\uD1B5 \uD69F\uC218\uC640 \uD655\uB960\uC5D0 \uB530\uB77C
      \uB4A4\uCABD \uC801\uC744 \uCD94\uAC00\uB85C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523401
    m_Localized: "\uB3C5\xB7\uAE30\uC808\xB7\uD45C\uC2DD\xB7\uC57D\uD654\uB97C \uBD80\uC5EC\uD558\uAC70\uB098
      \uD65C\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523402
    m_Localized: "\uD53C\uD574: "
    m_Metadata:
      m_Items: []
  - m_Id: 970523403
    m_Localized: ' <color=#67E480>(+ '
    m_Metadata:
      m_Items: []
  - m_Id: 970523404
    m_Localized: ')</color> = '
    m_Metadata:
      m_Items: []
  - m_Id: 970523405
    m_Localized: ' <color=#FF8066>(- '
    m_Metadata:
      m_Items: []
  - m_Id: 970523406
    m_Localized: ')</color> = '
    m_Metadata:
      m_Items: []
  - m_Id: 970523407
    m_Localized: "\uD604\uC7AC \uD53C\uD574 \uBC30\uC728: x"
    m_Metadata:
      m_Items: []
  - m_Id: 970523408
    m_Localized: "\uC720\uD6A8 \uBC94\uC704: "
    m_Metadata:
      m_Items: []
  - m_Id: 970523409
    m_Localized: " \uCE78"
    m_Metadata:
      m_Items: []
  - m_Id: 970523410
    m_Localized: "\uCE58\uBA85\uD0C0 \uD655\uB960: "
    m_Metadata:
      m_Items: []
  - m_Id: 970523411
    m_Localized: '% <color=#67E480>(+ '
    m_Metadata:
      m_Items: []
  - m_Id: 970523412
    m_Localized: '%p)</color> = '
    m_Metadata:
      m_Items: []
  - m_Id: 970523413
    m_Localized: "\uCE58\uBA85\uD0C0 \uBC30\uC728: x"
    m_Metadata:
      m_Items: []
  - m_Id: 970523414
    m_Localized: "<color=#B8C6D9>\uD604\uC7AC \uB204\uC801 \uC815\uBCF4</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 970523415
    m_Localized: "{0}\uC5D0\uAC8C \uB3C5 +{1}\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523416
    m_Localized: "{0}\uC5D0\uAC8C \uAE30\uC808 +{1}\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523417
    m_Localized: "{0}\uC5D0\uAC8C \uD45C\uC2DD +{1}\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523418
    m_Localized: "{0}\uC744 \uCD5C\uB300 {1}\uCE78 \uBC00\uCE69\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523419
    m_Localized: "{0}\uACFC \uC704\uCE58\uB97C \uAD50\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523420
    m_Localized: "\uAC00\uD55C \uC2E4\uC81C \uD53C\uD574\uB9CC\uD07C \uD50C\uB808\uC774\uC5B4
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523421
    m_Localized: "{0}\uC5D0\uAC8C \uC57D\uD654 +{1}\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523422
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uC758 \uCD5C\uB300 \uCCB4\uB825\uACFC
      \uD604\uC7AC \uCCB4\uB825\uC744 \uAC01\uAC01 {0} \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523423
    m_Localized: "{0}% \uD655\uB960\uB85C \uD0C4\uD658\uC774 \uC601\uAD6C \uD30C\uAD34\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523424
    m_Localized: "\uACE8\uB4DC\uB97C {0} \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523425
    m_Localized: "\uBC1C\uC0AC \uC9C1\uC804 \uC790\uC2E0\uB9CC \uB9C8\uC9C0\uB9C9
      \uC57D\uC2E4\uC5D0 \uB0A8\uC544 \uC788\uC73C\uBA74 \uCD5C\uC885 \uD53C\uD574\uAC00
      x{0}\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523426
    m_Localized: "\uBC1C\uC0AC\uD55C \uD0C4\uD658\uC744 \uC601\uAD6C \uD30C\uAD34\uD569\uB2C8\uB2E4.
      \uB0A8\uC740 \uD0C4\uD658\uB4E4\uC758 \uCE58\uBA85\uD0C0 \uD655\uB960\uC744
      +{0}%p \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523427
    m_Localized: "\uB2E4\uC74C \uD0C4\uD658\uC758 \uCD5C\uC885 \uD53C\uD574\uB97C
      +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4. \uD53C\uD574 \uBCF4\uB108\uC2A4\uB294
      \uB204\uC801\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523428
    m_Localized: "\uC9C1\uC804 \uD0C4\uD658\uC758 \uD53C\uD574\uC640 \uD6A8\uACFC\uB97C
      \uBCF5\uC81C\uD569\uB2C8\uB2E4. \uBCF5\uC81C\uB41C \uD53C\uD574\uC5D0\uB294
      x{0} \uBC30\uC728\uC744 \uC801\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523429
    m_Localized: "\uC2E4\uB9B0\uB354\uC5D0 \uB0A8\uC740 \uB2E4\uB978 \uACF5\uBA85
      \uD0C4\uD658 \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523430
    m_Localized: "\uBCF4\uC720 \uACE8\uB4DC {0}\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C
      +{1}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523431
    m_Localized: "\uC783\uC740 \uCCB4\uB825 {0}%\uB2F9 \uCE58\uBA85\uD0C0 \uD655\uB960\uC744
      +{1}%p \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523432
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825 {0}\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C
      +{1}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523433
    m_Localized: "\uBC29\uD5A5\uACFC \uAD00\uACC4\uC5C6\uC774 \uC0DD\uC874\uD55C
      \uBAA8\uB4E0 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523434
    m_Localized: "\uBC1C\uC0AC \uC2DC\uC791 \uC2DC \uBE48 \uC57D\uC2E4 \uD558\uB098\uB2F9
      \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523435
    m_Localized: "\uB300\uC0C1\uACFC\uC758 \uAC70\uB9AC 1\uCE78\uB2F9 \uCD5C\uC885
      \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523436
    m_Localized: "\uB300\uC0C1\uC758 \uC0C1\uD0DC\uC774\uC0C1 \uC2A4\uD0DD \uD558\uB098\uB2F9
      \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523437
    m_Localized: "\uBA85\uC911 \uB300\uC0C1\uC758 \uD65C\uC131 \uC0C1\uD0DC\uC774\uC0C1
      \uC2A4\uD0DD\uC744 x{0}\uBC30\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523438
    m_Localized: "\uC790\uC2E0\uC744 \uC81C\uC678\uD55C \uBCF4\uC720 \uD0C4\uD658
      \uD558\uB098\uB2F9 \uAE30\uBCF8 \uD53C\uD574\uAC00 {0} \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523439
    m_Localized: "\uCE58\uBA85\uD0C0 \uBC1C\uC0DD \uC2DC \uACE8\uB4DC\uB97C {0} \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523440
    m_Localized: "\uB204\uC801\uB41C \uB2E4\uC74C \uD0C4\uD658 \uD53C\uD574 \uBCF4\uB108\uC2A4\uC758
      {0}%\uB97C \uC2E4\uB9B0\uB354\uC5D0 \uB0A8\uC740 \uBAA8\uB4E0 \uD0C4\uD658\uC5D0
      \uBD84\uBC30\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523441
    m_Localized: "\uC55E\uC120 \uD0C4\uD658\uC774 \uBE44\uCE58\uBA85\uD0C0\uC774\uBA74
      \uB0A8\uC740 \uD0C4\uD658\uB4E4\uC774 \uC9D1\uC911 \uC2A4\uD0DD +{0}\uC744
      \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uC9D1\uC911 \uC2A4\uD0DD \uD558\uB098\uB2F9
      \uCE58\uBA85\uD0C0 \uD655\uB960\uC774 +{1}%p \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uCE58\uBA85\uD0C0 \uBC1C\uC0DD \uC2DC \uBAA8\uB4E0 \uC9D1\uC911 \uC2A4\uD0DD\uC744
      \uC18C\uBAA8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523442
    m_Localized: "\uB2E4\uB978 \uD0C4\uD658\uC774 \uCE58\uBA85\uD0C0\uB97C \uBC1C\uC0DD\uC2DC\uD0A4\uBA74
      \uC804\uB825 \uC2A4\uD0DD +1\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uC804\uB825
      \uC2A4\uD0DD \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uAC00 +{0}% \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uBC1C\uC0AC \uD6C4 \uC804\uB825 \uC2A4\uD0DD\uC758 {1}%\uB97C \uBCF4\uC874\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523443
    m_Localized: "\uB2E4\uB978 \uC0AC\uACA9\uC774 \uB05D\uB0A0 \uB54C\uB9C8\uB2E4
      \uD0C4\uD53C \uC2A4\uD0DD +1\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uD0C4\uD53C
      \uC2A4\uD0DD {0}\uAC1C\uB97C \uC18C\uBAA8\uD558\uC5EC {1}% \uC704\uB825\uC73C\uB85C
      \uCD94\uAC00 \uC0AC\uACA9\uD569\uB2C8\uB2E4. \uD55C \uBC88\uC5D0 \uCD5C\uB300
      {2}\uD68C \uCD94\uAC00 \uC0AC\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523444
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uC601\uAD6C \uD3EC\uC2DD \uC2A4\uD0DD
      +{0}\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uD3EC\uC2DD \uC2A4\uD0DD \uD558\uB098\uB2F9
      \uCD5C\uC885 \uD53C\uD574\uAC00 +{1}% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523445
    m_Localized: "\uB2E4\uB978 \uD0C4\uD658\uC774 \uC601\uAD6C \uD30C\uAD34\uB420
      \uB54C \uC720\uC0B0 \uC2A4\uD0DD +{0}\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4.
      \uC720\uC0B0 \uC2A4\uD0DD \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uAC00
      +{1}% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523446
    m_Localized: "\uBCF4\uC720\uD55C \uC11C\uB85C \uB2E4\uB978 \uD0C4\uD658 \uC885\uB958
      \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523447
    m_Localized: "\uC2E4\uB9B0\uB354\uC5D0 \uB0A8\uC740 \uB2E4\uB978 \uB4F1\uAE09
      \uD0C4\uD658 \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523448
    m_Localized: "\uBCF4\uC720\uD55C \uC5D0\uC774\uC2A4\xB7\uB808\uC804\uB4DC\uB9AC
      \uD0C4\uD658 \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523449
    m_Localized: "\uBCF4\uC720\uD55C \uC77C\uBC18\xB7\uB808\uC5B4 \uD0C4\uD658 \uD558\uB098\uB2F9
      \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523450
    m_Localized: "\uAC00\uC7A5 \uB9CE\uC774 \uBCF4\uC720\uD55C \uB4F1\uAE09\uC758
      \uD0C4\uD658 \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523451
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 1\uCE78 \uC774\uB3D9\uD560 \uB54C\uB9C8\uB2E4
      \uC774\uB3D9 \uC2A4\uD0DD +1\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uC774\uB3D9
      \uC2A4\uD0DD \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uAC00 +{0}% \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uBC1C\uC0AC \uD6C4 \uC774\uB3D9 \uC2A4\uD0DD\uC744 \uCD08\uAE30\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523452
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBC14\uB77C\uBCF4\uB294 \uBC18\uB300
      \uBC29\uD5A5\uC73C\uB85C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523453
    m_Localized: "\uBC1C\uC0AC \uD6C4 \uD50C\uB808\uC774\uC5B4\uAC00 \uBC18\uB300
      \uBC29\uD5A5\uC73C\uB85C {0}\uCE78 \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523454
    m_Localized: "\uC2E4\uB9B0\uB354\uC758 \uB9C8\uC9C0\uB9C9 \uD0C4\uD658\uC774\uBA74
      {0}% \uD655\uB960\uB85C \uCD94\uAC00 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523455
    m_Localized: "\uC774\uD6C4 \uBAA8\uB4E0 \uD0C4\uD658\uC758 \uCD5C\uC885 \uD53C\uD574\uB97C
      +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4. \uD53C\uD574 \uBCF4\uB108\uC2A4\uB294
      \uB204\uC801\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523456
    m_Localized: "\uD604\uC7AC \uC2E4\uB9B0\uB354\uC5D0\uC11C \uC55E\uC11C \uBC1C\uC0AC\uD55C
      \uBAA8\uB4E0 \uD0C4\uD658\uC758 \uD6A8\uACFC\uB97C \uB2E4\uC2DC \uC801\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523457
    m_Localized: "\uC774\uD6C4 \uBAA8\uB4E0 \uD0C4\uD658\uC758 \uCE58\uBA85\uD0C0
      \uD655\uB960\uC744 +{0}%p \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4. \uCE58\uBA85\uD0C0
      \uD655\uB960 \uBCF4\uB108\uC2A4\uB294 \uB204\uC801\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523458
    m_Localized: "\uB2E4\uC74C \uD0C4\uD658\uC758 \uCE58\uBA85\uD0C0 \uBC30\uC728\uC744
      +{0} \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4. \uCE58\uBA85\uD0C0 \uBC30\uC728
      \uBCF4\uB108\uC2A4\uB294 \uB204\uC801\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523459
    m_Localized: "\uD0C4\uD658 \uD6A8\uACFC\uB85C \uC774\uB3D9\uD560 \uB54C\uB9C8\uB2E4
      \uCD94\uC801 \uC2A4\uD0DD +1\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uBC1C\uC0AC
      \uD6C4 \uCD94\uC801 \uC2A4\uD0DD \uD558\uB098\uB2F9 \uBB34\uC791\uC704 \uC801\uC5D0\uAC8C
      \uD45C\uC2DD +{0}\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4. \uBC1C\uC0AC \uD6C4
      \uBAA8\uB4E0 \uCD94\uC801 \uC2A4\uD0DD\uC744 \uC18C\uBAA8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523460
    m_Localized: "\uC774\uBC88 \uD134\uC5D0 \uC774\uBBF8 \uD53C\uACA9\uB41C \uB300\uC0C1\uC5D0\uAC8C
      \uCD5C\uC885 \uD53C\uD574\uB97C +{0}% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523461
    m_Localized: "\uBC1C\uC0AC \uC2DC \uD50C\uB808\uC774\uC5B4\uAC00 \uCCB4\uB825
      {0}\uC744 \uC783\uC2B5\uB2C8\uB2E4. \uC774 \uD0C4\uD658\uC758 \uAE30\uBCF8
      \uD53C\uD574\uB97C +{1} \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523462
    m_Localized: "\uC783\uC740 \uCCB4\uB825 \uBE44\uC728\uC5D0 \uB530\uB77C \uCD5C\uC885
      \uD53C\uD574\uAC00 \uCD5C\uB300 +{0}% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523463
    m_Localized: "\uBC1C\uC0AC \uD6C4 \uD50C\uB808\uC774\uC5B4\uAC00 \uBC18\uB300
      \uBC29\uD5A5\uC744 \uBC14\uB77C\uBD05\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523464
    m_Localized: "\uAD00\uD1B5\uC740 \uCD5C\uB300 1\uD68C\uC785\uB2C8\uB2E4. \uAD00\uD1B5
      \uC131\uACF5 \uD655\uB960\uC740 {0}%\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523465
    m_Localized: "\uAD00\uD1B5\uC740 \uCD5C\uB300 {0}\uD68C\uC785\uB2C8\uB2E4. \uAC01
      \uAD00\uD1B5\uC758 \uC131\uACF5 \uD655\uB960\uC740 {1}%\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523466
    m_Localized: "\uCC28 "
    m_Metadata:
      m_Items: []
  - m_Id: 970523467
    m_Localized: "\uAD00\uD1B5\uC740 \uCD5C\uB300 {0}\uD68C\uC785\uB2C8\uB2E4. \uB2E8\uACC4\uBCC4
      \uC131\uACF5 \uD655\uB960\uC740 {1}\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523468
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC "
    m_Metadata:
      m_Items: []
  - m_Id: 970523469
    m_Localized: "\uCE58\uBA85\uD0C0 \uC2DC "
    m_Metadata:
      m_Items: []
  - m_Id: 970523470
    m_Localized: "\uAD00\uD1B5 \uC131\uACF5 \uC2DC "
    m_Metadata:
      m_Items: []
  - m_Id: 970523471
    m_Localized: "\uD6A8\uACFC \uC801\uC6A9 \uC2DC "
    m_Metadata:
      m_Items: []
  - m_Id: 970523472
    m_Localized: "\uD50C\uB808\uC774\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 970523473
    m_Localized: "\uBAA8\uB4E0 \uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 970523474
    m_Localized: "\uBA85\uC911\uD55C \uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 970523475
    m_Localized: "\uC774\uBC88 \uC2E4\uB9B0\uB354\uC5D0\uC11C \uD0C4\uD658\uC774
      \uD30C\uAD34\uB418\uC9C0 \uC54A\uC73C\uBA74 \uBC1C\uC0AC \uC885\uB8CC \uD6C4
      \uACE8\uB4DC\uB97C {0} \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523476
    m_Localized: " \uAC19\uC740 \uC870\uAC74\uC744 \uCDA9\uC871\uD558\uBA74 \uC0AC\uACA9\uC5D0
      \uC0AC\uC6A9\uD55C \uD134\uC744 \uB3CC\uB824\uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523477
    m_Localized: "\uCD94\uAC00 \uD0C4\uD658\uC744 \uC18C\uBAA8\uD558\uC9C0 \uC54A\uACE0
      \uC5F0\uC18D \uC0AC\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523478
    m_Localized: "{0} \uCD94\uAC00 \uC0AC\uACA9\uBCC4 \uC131\uACF5 \uD655\uB960\uC740
      {1}\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523479
    m_Localized: "\uCE78 "
    m_Metadata:
      m_Items: []
  - m_Id: 970523480
    m_Localized: "\uBA85\uC911\uD55C \uC801 \uB4A4\uCABD\uC73C\uB85C \uCD5C\uC885
      \uD53C\uD574\uB97C \uC804\uC774\uD569\uB2C8\uB2E4. \uAC70\uB9AC\uBCC4 \uC804\uC774
      \uBE44\uC728\uC740 {0}\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523481
    m_Localized: "\uBA85\uC911 \uB300\uC0C1\uC758 \uB3C5 \uC2A4\uD0DD\uC744 \uBAA8\uB450
      \uC18C\uBE44\uD569\uB2C8\uB2E4. \uB0A8\uC740 \uB3C5 \uD53C\uD574\uC758 {0}%\uB97C
      \uC989\uC2DC \uC801\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523482
    m_Localized: " \uB300\uC0C1\uC774 \uC0DD\uC874\uD558\uBA74 \uB3C5 +{0}\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523483
    m_Localized: "\uC2E4\uB9B0\uB354\uC5D0 \uC788\uB294 \uB3D9\uC548 \uC55E\uC11C
      \uBC1C\uC0AC\uB41C \uD0C4\uD658 \uD558\uB098\uB2F9 \uCD5C\uC885 \uD53C\uD574\uAC00
      +{0}% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523484
    m_Localized: "{0} \uCDA9\uC804 \uC2A4\uD0DD\uC5D0\uB294 \uC0C1\uD55C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523485
    m_Localized: "{0} \uCD5C\uB300 \uCDA9\uC804 \uC2A4\uD0DD\uC740 {1}\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523486
    m_Localized: "\uCE58\uBA85\uD0C0 \uBC1C\uC0DD \uC2DC \uC9D1\uC911 \uC2A4\uD0DD
      +{0}\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. \uC9D1\uC911 \uC2A4\uD0DD \uD558\uB098\uB2F9
      \uCE58\uBA85\uD0C0 \uBC30\uC728\uC774 +{1} \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uBE44\uCE58\uBA85\uD0C0 \uBC1C\uC0DD \uC2DC \uC9D1\uC911 \uC2A4\uD0DD\uC744
      \uCD08\uAE30\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523487
    m_Localized: " \uBE44\uCE58\uBA85\uD0C0 \uBC1C\uC0DD \uC2DC {0}% \uD655\uB960\uB85C
      \uD0C4\uD658\uC774 \uC601\uAD6C \uD30C\uAD34\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523488
    m_Localized: "{0} \uBC1C\uB3D9 \uD655\uB960\uC740 {1}%\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 970523489
    m_Localized: "\uB2C8\uB2E4.\n\u2022 "
    m_Metadata:
      m_Items: []
