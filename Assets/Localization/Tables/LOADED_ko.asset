  - m_Id: 970522942
    m_Localized: "<size=100><color=yellow>LOADED</color></size>\n| \uBB34\uBC95\uC790\uB4E4\uC744
      \uC4F0\uB7EC\uB728\uB9AC\uACE0 \uD604\uC0C1\uAE08\uC744 \uCC59\uACA8\uB77C\n\n\uD604\uC0C1\uAE08
      \uC0AC\uB0E5\uAFBC\uC778 \uB2F9\uC2E0\uC740 \uBB34\uBC95\uC790\uB4E4\uB85C
      \uAC00\uB4DD\uD55C \uB9C8\uC744\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.\n\uC801\uC758
      \uD589\uB3D9\uC744 \uC608\uCE21\uD558\uACE0 \uD0C4\uD658\uC744 \uAD6C\uC131\uD574
      \uBB34\uBC95\uC790\uB4E4\uC744 \uC18C\uD0D5\uD558\uC138\uC694.\n\n<color=purple>[\uD575\uC2EC
      \uADDC\uCE59 3\uAC1C]</color>\n<color=orange>1.</color> \uC801\uC758 \uACF5\uACA9
      \uD589\uB3D9\uC740 \uBBF8\uB9AC \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n<color=orange>2.</color>
      \uD0C4\uD658\uC740 \uC2E4\uB9B0\uB354\uC758 \uC21C\uC11C\uB300\uB85C \uBC1C\uC0AC\uB429\uB2C8\uB2E4.
      \n<color=orange>3.</color> \uC2E4\uB9B0\uB354\uC5D0 \uC7A5\uC804\uB41C \uD0C4\uD658\uC758
      \uC21C\uC11C\uC5D0 \uB530\uB77C \uACF5\uACA9 \uACB0\uACFC\uAC00 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.\n\n<color=purple>[\uD301]</color>\n<color=orange>1.</color>
      \uBC1C\uC0AC \uBC84\uD2BC\uC744 \uB204\uB974\uAE30 \uC804 \uD0C4\uD658\uC5D0
      \uB9C8\uC6B0\uC2A4\uB97C \uD638\uBC84\uD558\uC5EC \uC608\uC0C1 \uD53C\uD574\uB97C
      \uD655\uC778\uD558\uC138\uC694!\n<color=orange>2.</color> \uC0AC\uACA9 \uC9C1\uC804
      \uD0C4\uD658 \uC21C\uC11C\uC640 \uC2DC\uB108\uC9C0\uB97C \uAF2D \uD655\uC778\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
