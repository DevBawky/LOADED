  - m_Id: 974717067
    m_Localized: "<color=#FFD05A><b>MISSION</b></color>  <color=#8FE6FF><b>\uBCF4\uC720
      \uC544\uC774\uD15C \uD55C \uBC88 \uC0AC\uC6A9</b></color>"
