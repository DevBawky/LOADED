    m_Metadata:
      m_Items: []
  - m_Id: 974717122
    m_Localized: "\uCD1D \uBC1C\uC0AC \uC218: "
    m_Metadata:
      m_Items: []
  - m_Id: 974717123
    m_Localized: "COUNT \uB2F9 \uD3C9\uADE0 \uB300\uBBF8\uC9C0: "
    m_Metadata:
      m_Items: []
  - m_Id: 974717124
    m_Localized: "\uD3C9\uADE0 \uBC1C \uB2F9 \uB300\uBBF8\uC9C0: "
    m_Metadata:
      m_Items: []
  - m_Id: 974717125
    m_Localized: "\uD68D\uB4DD\uD55C \uACE8\uB4DC: "
    m_Metadata:
      m_Items: []
  - m_Id: 974717126
    m_Localized: "\uC815\uC0B0: $ {0:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 974717127
    m_Localized: "\uC815\uC0B0 \uBCF4\uB108\uC2A4: <color={0}>\uCD94\uAC00 \uACE8\uB4DC
      +{1}%</color> (\uBA54\uB2EC \uCD1D\uC810 <color=orange>{2}</color>/9)\n<color=#FFE21A>($
      {3:N0} \xD7 {4}% = $ {5:N0})</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 974717128
    m_Localized: "\uC815\uC0B0: $ {0:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 974717129
    m_Localized: "\uD0C4\uD658\uC758 \uC7A5\uC804 \uC21C\uC11C\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717130
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C\uB294 \uB2E4\uC74C \uC804\uD22C\uB97C
      \uBBF8\uB9AC \uC900\uBE44\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717131
    m_Localized: "\uC704\uD5D8\uD55C \uC801\uBD80\uD130 \uC81C\uAC70\uD558\uBA74
      \uD53C\uD574\uB97C \uC904\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717132
    m_Localized: "\uD0C4\uD658 \uD6A8\uACFC\uC758 \uC870\uD569\uC774 \uC804\uD22C\uC758
      \uD750\uB984\uC744 \uBC14\uAFC9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717133
    m_Localized: "\uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 974717134
    m_Localized: "\uC5EC\uC815\uC774 \uC2DC\uC791\uB418\uB294 \uC9C0\uC810\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717135
    m_Localized: "\uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717136
    m_Localized: "\uC77C\uBC18 \uC801\uB4E4\uACFC \uC804\uD22C\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717137
    m_Localized: "\uC815\uC608 \uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717138
    m_Localized: "\uAC15\uB825\uD55C \uC815\uC608 \uC801\uB4E4\uACFC \uC804\uD22C\uB97C
      \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717139
    m_Localized: "\uC0C1\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 974717140
    m_Localized: "\uC544\uC774\uD15C\uC744 \uAD6C\uB9E4\uD558\uACE0 \uC804\uC5F4\uC744
      \uC815\uBE44\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717141
    m_Localized: "\uBCF4\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717142
    m_Localized: "\uBCF4\uBB3C\uC0C1\uC790\uB97C \uC5F4\uC5B4 \uC720\uBB3C\uC744
      \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717143
    m_Localized: "\uC774\uBCA4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 974717144
    m_Localized: "\uD2B9\uBCC4\uD55C \uC0AC\uAC74\uACFC \uC120\uD0DD\uC9C0\uB97C
      \uB9CC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717145
    m_Localized: "\uBCF4\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 974717146
    m_Localized: "\uC2A4\uD14C\uC774\uC9C0\uC758 \uBCF4\uC2A4\uC640 \uACB0\uC804\uC744
      \uCE58\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 974717147
    m_Localized: "<color=#58E879><b>\uD589\uC6B4\uC758 \uC57D\uC2E4 \uC801\uC6A9</b></color>\n<color=#A8F5B8>\uCD5C\uC885
      \uD53C\uD574 +{0:0.#}%</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 974717148
    m_Localized: "\uCE58\uBA85\uD0C0 \uD655\uC815, \uCD5C\uC885 \uD53C\uD574 x{0}"
    m_Metadata:
      m_Items: []
