      m_Items: []
  - m_Id: 974717068
    m_Localized: "\uBBF8\uC158 \uC7AC\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717069
    m_Localized: "\uC544\uC774\uD15C \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717070
    m_Localized: "<color=#FF5757><b>1/2/3 \uD0A4</b></color> \uB610\uB294 <color=#FF5757><b>\uC778\uBCA4\uD1A0\uB9AC
      \uC2AC\uB86F \uD074\uB9AD</b></color>\uC73C\uB85C \uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n<color=#FFD05A><b>\uC0AC\uC6A9 \uC870\uAC74\uC774
      \uB9DE\uC9C0 \uC54A\uC73C\uBA74 \uC18C\uBE44\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</b></color>\n\uC801\uC774
      \uB098\uC628 \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717071
    m_Localized: "\uBCF4\uC720 \uC544\uC774\uD15C \uD55C \uBC88 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717072
    m_Localized: "\uBBF8\uC158 \uC7AC\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 974717073
    m_Localized: "\uD0C4\uD658 3\uD68C \uC7A5\uC804 ({0}/3)"
    m_Metadata:
      m_Items: []
  - m_Id: 974717074
    m_Localized: "\uC801\uC758 \uACF5\uACA9\uC73C\uB85C\uBD80\uD130 \uD68C\uD53C\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 974717075
    m_Localized: "\uC801 \uD589\uB3D9 \uC544\uC774\uCF58\uC774 \uB098\uD0C0\uB0A0
      \uB54C\uAE4C\uC9C0 \uD68C\uC804\uD574 DUEL CLOCK \uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717076
    m_Localized: "\uC2E4\uB9B0\uB354\uB97C \uBC1C\uC0AC\uD574 \uC7A5\uC804 \uACF5\uAC04
      \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717077
    m_Localized: "\uC81C\uAC70\uD560 \uD0C4\uD658 1\uBC1C \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717078
    m_Localized: "\uD655\uC778\uD560 \uD0C4\uD658 1\uBC1C \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717079
    m_Localized: "\uBC1C\uC0AC\uD560 \uD0C4\uD658 1\uBC1C \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717080
    m_Localized: "\uC2E4\uB9B0\uB354\uC5D0 \uD0C4\uD658 2\uBC1C \uC774\uC0C1 \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717081
    m_Localized: "\uC0AC\uC6A9\uD560 \uC544\uC774\uD15C\uC774 \uC9C0\uAE09\uB420
      \uB54C\uAE4C\uC9C0 \uC7A0\uC2DC \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717082
    m_Localized: "\uC774\uB3D9\uD560 \uC218 \uC788\uB3C4\uB85D \uC778\uC811\uD55C
      \uC801 \uBC14\uB77C\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717083
    m_Localized: "\uC774\uB3D9 \uACBD\uB85C\uAC00 \uC5F4\uB9B4 \uB54C\uAE4C\uC9C0
      \uD68C\uC804\uD574 DUEL CLOCK \uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717084
    m_Localized: "\uC608\uC0C1 \uD53C\uD574\uB97C \uD655\uC778\uD560 \uD0C4\uD658
      \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717085
    m_Localized: "\uACF5\uACA9\uD560 \uC801 \uBC14\uB77C\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717086
    m_Localized: "\uC801\uC774 \uD0C4\uD658 \uC0AC\uAC70\uB9AC {0}\uCE78 \uC548\uC5D0
      \uB4E4\uB3C4\uB85D \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717087
    m_Localized: "\uC801\uC774 \uB4F1\uC7A5\uD560 \uB54C\uAE4C\uC9C0 \uD68C\uC804\uD574
      DUEL CLOCK \uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717088
    m_Localized: "\uC801\uC774 \uB4F1\uC7A5\uD560 \uB54C\uAE4C\uC9C0 \uD68C\uC804\uD574
      DUEL CLOCK \uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 974717089
    m_Localized: "\uC801 \uBC14\uB85C \uC55E\uAE4C\uC9C0 \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 974717090
    m_Localized: "\uC778\uC811\uD55C \uC801 \uBC14\uB77C\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 974717091
    m_Localized: "\uBC1C\uCC28\uAE30 \uC7AC\uC0AC\uC6A9\uAE4C\uC9C0 \uD68C\uC804
      ({0}\uD68C \uD589\uB3D9)"
    m_Metadata:
      m_Items: []
  - m_Id: 974717092
    m_Localized: "\uC804\uD22C \uAC00\uC774\uB4DC \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717093
    m_Localized: "\uC774\uC81C <color=#FFD05A><b>DUEL CLOCK, \uCF64\uBCF4\uC640 \uC801
      \uD589\uB3D9</b></color>\uC744 \uD655\uC778\uD558\uBA70 \uC804\uD22C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 974717094
    m_Localized: "\uC544\uC774\uD15C \uAC00\uC774\uB4DC \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 974717095
    m_Localized: "\uC544\uC774\uD15C\uC740 <color=#FFD05A><b>\uD544\uC694\uD55C \uC21C\uAC04\uC5D0
      \uBC14\uB85C \uC0AC\uC6A9</b></color>\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
