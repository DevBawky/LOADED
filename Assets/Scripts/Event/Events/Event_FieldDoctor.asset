  eventId: field-doctor
  displayName: "\uB5A0\uB3CC\uC774 \uC57C\uC804 \uC758\uC0AC"
  artwork: {fileID: 21300000, guid: 59891d5fa2b6b1b468500267c9e11b00, type: 3}
  dialogue: "\uBA3C\uC9C0\uD22C\uC131\uC774 \uB9C8\uCC28 \uC606\uC5D0\uC11C \uC758\uC0AC\uAC00
    \uD53C \uBB3B\uC740 \uB3C4\uAD6C\uB97C \uB2E6\uACE0 \uC788\uB2E4. \uADF8\uB294
    \uB2F9\uC2E0\uC758 \uC0C1\uCC98\uB97C \uD6D1\uC5B4\uBCF4\uB354\uB2C8 \uC190\uBC14\uB2E5\uC744
    \uB0B4\uBBFC\uB2E4."
  choices:
  - buttonText: "[\uCE58\uB8CC\uBC1B\uB294\uB2E4] 15 \uACE8\uB4DC\uB97C \uB0B4\uACE0
      \uCCB4\uB825\uC744 25 \uD68C\uBCF5\uD55C\uB2E4."
    outcomeText: "\uAC70\uCE5C \uCE58\uB8CC\uC600\uC9C0\uB9CC \uCD9C\uD608\uC740
      \uBA4E\uC5C8\uACE0 \uD1B5\uC99D\uB3C4 \uD55C\uACB0 \uAC00\uB77C\uC549\uC558\uB2E4."
    requirements:
    - type: 1
      amount: 15
      unavailableReason: "15 \uACE8\uB4DC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    effects:
    - type: 1
      amount: 15
      bullet: {fileID: 0}
    - type: 2
      amount: 25
      bullet: {fileID: 0}
  - buttonText: "[\uD0C4\uD658\uC744 \uC218\uC220 \uB3C4\uAD6C\uB85C \uC900\uB2E4]
      \uD0C4\uD658 \uD558\uB098\uB97C \uC81C\uAC70\uD558\uACE0 \uCCB4\uB825\uC744
      40 \uD68C\uBCF5\uD55C\uB2E4."
    outcomeText: "\uC758\uC0AC\uB294 \uD0C4\uD658\uC744 \uBD84\uD574\uD574 \uB9CC\uB4E0
      \uB3C4\uAD6C\uB85C \uAE4A\uC740 \uC0C1\uCC98\uAE4C\uC9C0 \uCE58\uB8CC\uD588\uB2E4."
    requirements:
    - type: 2
      amount: 0
      unavailableReason: "\uC81C\uAC70\uD560 \uC218 \uC788\uB294 \uD0C4\uD658\uC774
        \uC5C6\uC2B5\uB2C8\uB2E4."
    effects:
    - type: 5
      amount: 0
      bullet: {fileID: 0}
    - type: 2
      amount: 40
      bullet: {fileID: 0}
  - buttonText: "[\uAC70\uC808\uD55C\uB2E4] \uC758\uC0AC\uB97C \uBBFF\uC9C0 \uC54A\uB294\uB2E4."
    outcomeText: "\uC758\uC0AC\uB294 \uC544\uC27D\uB2E4\uB294 \uB4EF \uB3C4\uAD6C\uB97C
