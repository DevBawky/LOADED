  choices:
  - buttonText: "[\uD1B5\uD589\uC138\uB97C \uB0B8\uB2E4] 15 \uACE8\uB4DC\uB97C \uC783\uB294\uB2E4."
    outcomeText: "\uC9D5\uC218\uAD00\uC740 \uB3D9\uC804\uC744 \uC138\uC5B4 \uBCF8
      \uB4A4 \uB9C8\uC9C0\uBABB\uD574 \uAE38\uC744 \uBE44\uCF30\uB2E4."
    requirements:
    - type: 1
      amount: 15
      unavailableReason: "15 \uACE8\uB4DC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    effects:
    - type: 1
      amount: 15
      bullet: {fileID: 0}
  - buttonText: "[\uB3CC\uD30C\uD55C\uB2E4] \uCCB4\uB825\uC744 12 \uC783\uB294\uB2E4."
    outcomeText: "\uAC70\uCE5C \uBAB8\uC2F8\uC6C0 \uB05D\uC5D0 \uAE38\uC744 \uB6AB\uC5C8\uC9C0\uB9CC
      \uACF3\uACF3\uC5D0 \uC0C8 \uC0C1\uCC98\uAC00 \uB0A8\uC558\uB2E4."
    requirements: []
    effects:
    - type: 3
      amount: 12
      bullet: {fileID: 0}
  - buttonText: "[\uD0C4\uD658\uC744 \uAC74\uB128\uB2E4] \uD0C4\uD658 \uD558\uB098\uB97C
      \uC81C\uAC70\uD55C\uB2E4."
    outcomeText: "\uC9D5\uC218\uAD00\uC740 \uD0C4\uD658\uC744 \uBC1B\uC544 \uB4E4\uACE0
