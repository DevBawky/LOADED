  displayName: "\uD669\uC57C\uC758 \uC9D5\uC218\uAD00"
  artwork: {fileID: 21300000, guid: 59891d5fa2b6b1b468500267c9e11b00, type: 3}
  dialogue: "\uAC80\uC740 \uBAA8\uC790\uB97C \uB20C\uB7EC\uC4F4 \uB0A8\uC790\uB4E4\uC774
    \uAE38\uC744 \uB9C9\uB294\uB2E4. \uC120\uB450\uC758 \uB0A8\uC790\uAC00 \uC7A5\uBD80\uB97C
