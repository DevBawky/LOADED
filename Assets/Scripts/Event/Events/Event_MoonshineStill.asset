    outcomeText: "\uBAA9\uAD6C\uBA4D\uC740 \uBD88\uD0C0\uB294 \uB4EF\uD588\uC9C0\uB9CC
      \uBAB8\uC5D0 \uD798\uC774 \uB418\uB3CC\uC544\uC654\uB2E4."
