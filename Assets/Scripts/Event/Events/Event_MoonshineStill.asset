  artwork: {fileID: 21300000, guid: 59891d5fa2b6b1b468500267c9e11b00, type: 3}
  dialogue: "\uD611\uACE1 \uC548\uCABD\uC5D0\uC11C \uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4
    \uB3C5\uD55C \uB0C4\uC0C8\uAC00 \uD48D\uACA8 \uC628\uB2E4. \uC870\uC7A1\uD55C
    \uC99D\uB958\uAE30 \uC606\uC5D0 \uB193\uC778 \uC0C1\uC790\uC5D0\uB294 \uC220\uBCD1\uACFC
