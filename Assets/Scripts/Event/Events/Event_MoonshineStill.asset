      amount: 5
      bullet: {fileID: 0}
    - type: 2
      amount: 20
      bullet: {fileID: 0}
  - buttonText: "[\uC220\uBCD1\uC744 \uD6D4\uCCD0 \uD310\uB2E4] \uCCB4\uB825\uC744
      6 \uC783\uACE0 15 \uACE8\uB4DC\uB97C \uC5BB\uB294\uB2E4."
    outcomeText: "\uC8FC\uC778\uC5D0\uAC8C \uB4E4\uCF1C \uD55C \uB300 \uC5BB\uC5B4\uB9DE\uC558\uC9C0\uB9CC
